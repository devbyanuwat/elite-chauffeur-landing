---
const stops = [
  { id: 'services', th: 'เรื่องของเรา', en: 'Our story' },
  { id: 'fleet', th: 'รถของเรา', en: 'Our fleet' },
  { id: 'how', th: 'วิธีจอง', en: 'How to book' },
  { id: 'routes', th: 'เส้นทาง', en: 'Routes' },
  { id: 'stats', th: 'ตัวเลข', en: 'By the numbers' },
  { id: 'why', th: 'ทำไมต้องเรา', en: 'Why us' },
  // fix round 2: reviews/faq/booking carry no data-chapter (not pinned
  // chapters), so they're never in collectChapters()'s output — but the
  // visitor still scrolls through them, and aria-current was getting stuck
  // on `why` for the rest of the page. initRail now resolves stops from
  // these dots' href directly rather than from the chapter list, so listing
  // them here is what makes them light up at all. Order matches page order
  // in src/pages/index.astro (Why → Reviews → Faq → Booking).
  { id: 'reviews', th: 'รีวิว', en: 'Reviews' },
  { id: 'faq', th: 'คำถามบ่อย', en: 'FAQ' },
  { id: 'booking', th: 'จองรถ', en: 'Booking' },
];
---

<nav id="chapter-rail" aria-label="บทของหน้านี้">
  <span data-rail-label aria-hidden="true"></span>
  <ul>
    {stops.map((stop) => (
      <li>
        <a href={`#${stop.id}`} data-rail-dot data-rail-name={stop.th}>
          <span class="sr-only">{stop.th}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  /* rail โผล่เฉพาะเมื่อ initRail ต่อสายสำเร็จ — ไม่มี JavaScript ก็ไม่มีจุดลอย
     ค้างที่กดแล้วไม่มีอะไรเกิดขึ้น */
  #chapter-rail {
    display: none;
  }

  #chapter-rail.rail-ready {
    position: fixed;
    right: clamp(10px, 1.4vw, 20px);
    top: 50%;
    transform: translateY(-50%);
    /* จบเหนือแนว sticky CTA และ LINE fab ที่มุมล่างขวา */
    max-height: min(60svh, 420px);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    z-index: 40;
  }

  #chapter-rail ul {
    display: grid;
    gap: 0.55rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #chapter-rail a {
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-secondary);
    opacity: 0.3;
    transition: opacity 0.3s, transform 0.3s;
  }

  #chapter-rail a.on {
    background: var(--gold-dark);
    opacity: 1;
    transform: scale(1.5);
  }

  #chapter-rail [data-rail-label] {
    font-size: 0.72rem;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  @media (max-width: 1023px) {
    #chapter-rail [data-rail-label] {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #chapter-rail a {
      transition: none;
    }
  }

  /* fix round 2: nine dots at the default 0.55rem gap grow the rail by
     roughly 40px over the six-dot baseline (7px dot + 0.55rem gap × 3 more
     stops) that was measured against #sticky-cta / LineFab at 390×640 and
     found 158px/210px clear — plenty of margin there. A short viewport
     (landscape phones, embedded webviews) has far less headroom, and
     max-height only caps overflow, it doesn't shrink the rail's actual
     height. Tighten the gap directly below 480px tall so growth can't eat
     into the CTA/fab corner. */
  @media (max-height: 480px) {
    #chapter-rail.rail-ready {
      max-height: min(45svh, 220px);
    }

    #chapter-rail ul {
      gap: 0.3rem;
    }
  }
</style>

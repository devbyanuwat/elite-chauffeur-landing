      <a class="svc" data-i="3" href="#booking">
        <span class="n">04</span>
        <span class="svc-body">
          <span class="svc-h" data-i18n="intro.4.t">องค์กร &amp; ผู้บริหาร</span>
          <span class="svc-p" data-i18n="intro.4.d">มาตรฐานที่ฝากแขกคนสำคัญได้ ออกใบกำกับภาษีได้</span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  /* ================= default (no-JS / <1024 / reduced-motion): plain stack, everything visible ================= */
  .intro-chapter {
    position: relative;
    overflow: clip;
    background: var(--bg-primary);
  }

  .intro-viewport {
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 5vw, 32px);
  }

  .intro-photo {
    position: relative;
    height: 46svh;
    border-radius: var(--r-md);
    overflow: hidden;
  }

  .intro-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 55%;
  }

  /* the four alternate service photos are purely decorative crossfade targets
     for the desktop scroll transform — the base photo above already carries
     the meaningful image, so hiding these by default (no JS) loses nothing */
  .intro-photo .svc-img {
    opacity: 0;
    transform: scale(1.06);
  }

  .intro-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, oklch(20% 0.022 235 / 0.55));
  }

  .intro-hero-copy {
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    top: 46svh;
    transform: translateY(calc(-100% - 1.1rem));
    max-width: none;
    z-index: 2;
  }

  .intro-hero-copy h2 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 7.5vw, 2.4rem);
    font-weight: 500;
    line-height: 1.15;
    color: #fff;
    text-shadow: 0 2px 18px oklch(20% 0.02 235 / 0.55);
  }

  .intro-hero-copy h2 .u {
    font-style: normal;
    background: linear-gradient(transparent 62%, var(--sun) 62% 90%, transparent 90%);
  }

  .intro-hero-copy h2 .g {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    color: var(--gold-light);
  }

  .intro-hero-copy p {
    margin-top: 1rem;
    color: oklch(94% 0.01 80);
  }

  .intro-services {
    padding: 2rem 1.25rem 0;
    opacity: 1;
  }

  .ch-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold-dark);
    font-weight: 600;
    margin-bottom: 1.2rem;
  }

  .svc {
    display: flex;
    gap: 1.1rem;
    padding: 1.05rem 0;
    border-top: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    opacity: 1;
    transition: opacity 0.35s;
  }

  .svc:last-child {
    border-bottom: 1px solid var(--border);
  }

  .svc .n {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--gold-dark);
    min-width: 2ch;
  }

  .svc-h {
    display: block;
    font-size: 1.08rem;
    font-weight: 600;
  }

  .svc-p {
    display: block;
    font-size: 0.86rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
    max-width: 40ch;
  }

  /* ================= pin-ready (ทุกความกว้าง), motion allowed: Editions overlay =================
     pin-ready มาจาก editions.ts เท่านั้น (ตอนนี้ทำงานทั้ง full และ lite tier —
     Task 6) ดังนั้น layout ด้านบนยังเป็นพฤติกรรมพื้นสำหรับทุกกรณีที่ pin ไม่ได้ทำงาน */
  .intro-chapter.pin-ready {
    height: 100svh;
  }

  .intro-chapter.pin-ready .intro-viewport {
    height: 100%;
    padding: 0;
  }

  .intro-chapter.pin-ready .intro-photo {
    position: absolute;
    inset: 0;
    height: auto;
    border-radius: 0;
    z-index: 1;
    will-change: transform;
  }

  /* editions.ts's buildIntroChapter drives top/bottom/left/right/border-radius
     via gsap.set on scroll — this is only the resting (progress 0) box */
  .intro-chapter.pin-ready .intro-veil {
    background: linear-gradient(102deg, transparent 0 42%, oklch(98% 0.008 75 / 0.5) 62%, oklch(98% 0.008 75 / 0.85) 100%);
  }

  .intro-chapter.pin-ready .intro-hero-copy {
    left: auto;
    right: clamp(24px, 6vw, 90px);
    top: 50%;
    bottom: auto;
    transform: translateY(-50%);
    max-width: 520px;
    text-align: left;
  }

  .intro-chapter.pin-ready .intro-hero-copy h2 {
    font-size: clamp(2.4rem, 4.6vw, 4.2rem);
    color: var(--text-primary);
    text-shadow: none;
  }

  .intro-chapter.pin-ready .intro-hero-copy h2 .g {
    color: var(--gold-dark);
  }

  .intro-chapter.pin-ready .intro-hero-copy p {
    color: var(--text-secondary);
  }

  .intro-chapter.pin-ready .intro-services {
    position: absolute;
    left: clamp(24px, 6vw, 90px);
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: min(40vw, 480px);
    padding: 0;
    /* opacity/x driven by gsap.set from progress .45 onward — this is just
       the resting value before the first onUpdate frame runs */
    opacity: 0;
  }

  .intro-chapter.pin-ready .svc {
    opacity: 0.35;
    cursor: default;
  }

  .intro-chapter.pin-ready .svc.on {
    opacity: 1;
  }

  .intro-chapter.pin-ready .svc-p {
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: opacity 0.4s, max-height 0.4s;
  }

  .intro-chapter.pin-ready .svc.on .svc-p {
    opacity: 1;
    max-height: 4em;
  }
</style>

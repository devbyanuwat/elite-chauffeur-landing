<!-- chapter 0 · hero → services transform (ports mockups/pinned-editions.html #intro)
     id="services" kept so Nav.astro's existing /#services anchor still lands here.
     data-chapter / data-chapter-len is editions.ts's own contract (separate from
     pin.ts's data-pin/data-stage — this chapter's timeline is a single continuous
     transform, not a stage-swap sequence). Default (no .pin-ready — no JS, <1024px,
     or reduced motion) renders as a plain stacked layout with the photo, headline
     and all 4 services fully visible; the absolute Editions-style overlay only
     exists once buildIntroChapter() has actually attached a working ScrollTrigger. -->
<section class="chapter intro-chapter" id="services" data-chapter="intro" data-chapter-len="420">
  <div class="intro-viewport">
    <div class="intro-photo">
      <img class="intro-photo-img" data-drift-img="10" src="/images/parallax/hero/color.webp" alt="" width="1920" height="1080" loading="lazy">
      <img class="svc-img" data-svc="0" src="/images/parallax/airport/color.webp" alt="">
      <img class="svc-img" data-svc="1" src="/images/parallax/service/rental/color.webp" alt="">
      <img class="svc-img" data-svc="2" src="/images/service-van-hero.webp" alt="">

---
// chapter 2 · how (ports mockups/pinned-editions.html #how + its separate
// .how-mobile block). data-chapter / data-chapter-len is editions.ts's own
// contract — separate from pin.ts's data-pin/data-stage (old attributes
// removed here). Default (no .pin-ready — no JS, <1024px, or reduced motion)
// renders the collage grid with step 1 already active/readable and all three
// steps' copy fully visible; the theatrical single-active-step dimming +
// numeral swap only exists once buildHowChapter() has attached a working
// ScrollTrigger, same convention as IntroStory/Fleet. Below 1024px the whole
// collage is swapped for `.how-mobile` (3 static `.hm-step` blocks — T7 adds
// their bouncy in/out timelines, this task ships them fully visible).
const STEPS = [
  {
    k: 'how.1.k',
    kFallback: 'ขั้นที่ 1',
    t: 'how.1.t',
    tFallback: 'บอกทริปของคุณ',
    d: 'how.1.d',
    dFallback: 'กรอกจุดรับ ปลายทาง วันเวลา — ไม่ถึงนาทีก็เสร็จ ไม่ต้องสมัครสมาชิก',
    tag: 'how.1.tag',
    tagFallback: 'ใช้เวลาไม่ถึง 1 นาที',
    img: '/images/parallax/hero/color.webp',
  },
  {
    k: 'how.2.k',
    kFallback: 'ขั้นที่ 2',
    t: 'how.2.t',
    tFallback: 'รับราคายืนยันใน 15 นาที',
    d: 'how.2.d',
    dFallback: 'ทีมงานยืนยันราคารวมทุกอย่างก่อนจอง ไม่มีบวกเพิ่มหน้างาน',
    tag: 'how.2.tag',
    tagFallback: 'ราคาล็อกตั้งแต่จอง',
    img: '/images/parallax/airport/color.webp',
  },
  {
    k: 'how.3.k',
    kFallback: 'ขั้นที่ 3',
    t: 'how.3.t',
    tFallback: 'ออกเดินทางสบายใจ',
    d: 'how.3.d',
    dFallback: 'คนขับมารับตรงเวลา ติดตามการเดินทางได้ พักผ่อนได้เต็มที่ตลอดทาง',
    tag: 'how.3.tag',
    tagFallback: 'ตรงเวลา · มีประกันทุกคัน',
    img: '/images/parallax/trust/color.webp',
  },
];
---

<section class="chapter how-chapter" id="how" data-chapter="how" data-chapter-len="300">
  <div class="how-viewport">
    <div class="ch-head">
      <div>
        <span class="ch-eyebrow" data-i18n="how.eyebrow">ขั้นตอนง่าย ๆ</span>
        <h2 class="ch-title" data-i18n="how.title">จองรถได้ใน 3 ขั้นตอน</h2>
      </div>
    </div>

    <div class="how-grid">
      <div class="hugely">
        <div class="how-media">
          {STEPS.map((s, i) => (
            <img src={s.img} alt="" class={i === 0 ? 'on' : ''} />
          ))}
          <div class="tone"></div>
          {/* fix-review M1: this initial caption mirrors step 1's h3 (same
              key, how.1.t) so the EN toggle localizes it before any scroll —
              i18n.ts queries every [data-i18n] element, so two elements
              sharing one key is fine, both get the same localized string.
              buildHowChapter()'s stage-change handler continues to own this
              element afterward by reading the *live* (already-localized) h3
              textContent of the newly active step, so it stays in sync with
              whichever language is active regardless of when the toggle
              happened relative to the scroll. */}
          <div class="how-cap" data-i18n="how.1.t">{STEPS[0].tFallback}</div>
        </div>
        <span>1</span>
      </div>

      <div class="how-steps">
        <div class="line"></div>
        {STEPS.map((s, i) => (
          <div class={i === 0 ? 'how-step on' : 'how-step'}>
            <div class="k" data-i18n={s.k}>{s.kFallback}</div>
            <h3 data-i18n={s.t}>{s.tFallback}</h3>
            <p data-i18n={s.d}>{s.dFallback}</p>
            <span class="t" data-i18n={s.tag}>{s.tagFallback}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- mobile only: one block per step, image + copy travel together
         (static in this task — T7 wires the in/out scroll timelines) -->
    <div class="how-mobile">
      {STEPS.map((s, i) => (
        <div class="hm-step">
          <div class="hm-media">
            <img src={s.img} alt="" data-drift-img="12" />
            <span class="hm-n">{i + 1}</span>
          </div>
          <div class="hm-body">
            <div class="k" data-i18n={s.k}>{s.kFallback}</div>
            <h3 data-i18n={s.t}>{s.tFallback}</h3>
            <p data-i18n={s.d}>{s.dFallback}</p>
            <span class="t" data-i18n={s.tag}>{s.tagFallback}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ================= default (no-JS / <1024 / reduced-motion): everything readable ================= */
  .how-chapter {
    position: relative;
    overflow: clip;
    background: var(--bg-secondary);
  }

  .how-viewport {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: clamp(20px, 5vw, 32px);
  }

  .ch-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .ch-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold-dark);
    font-weight: 600;
  }

  .ch-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    margin-top: 0.35rem;
  }

  .how-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }

  /* collage: photo card + solid numeral overlapping it */
  .hugely {
    position: relative;
    height: min(56vh, 520px);
  }

  .how-media {
    position: absolute;
    inset: 0 8% 6% 0;
    border-radius: var(--r-md);
    overflow: hidden;
    box-shadow: 0 30px 60px oklch(24% 0.02 60 / 0.18);
    background: #111;
  }

  /* the two alternate step photos are decorative crossfade targets for the
     desktop scroll narrative — step 1's photo already carries the meaningful
     image, so hiding these by default (no JS) loses nothing, same convention
     as IntroStory's .svc-img */
  .how-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.08);
    transition: opacity 0.6s, transform 0.8s;
  }

  .how-media img.on {
    opacity: 1;
    transform: scale(1);
  }

  .how-media .tone {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, transparent 45%, oklch(20% 0.022 235 / 0.42));
  }

  .hugely span {
    position: absolute;
    right: -2%;
    bottom: -8%;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(9rem, 30vh, 17rem);
    line-height: 0.8;
    color: var(--gold);
    text-shadow: 0 18px 40px oklch(24% 0.02 60 / 0.25);
  }

  .how-cap {
    position: absolute;
    left: 1.2rem;
    bottom: 1rem;
    color: oklch(96% 0.006 80);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .how-steps {
    display: grid;
    gap: 0;
    position: relative;
  }

  .how-steps::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }

  .how-steps .line {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    background: var(--gold);
    height: 0;
  }

  .how-step {
    padding: 1.4rem 0 1.4rem 1.8rem;
    opacity: 1;
  }

  .how-step h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
    transition: font-size 0.35s;
  }

  .how-step.on h3 {
    font-size: 1.5rem;
  }

  .how-step p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    max-width: 44ch;
  }

  .how-step .k {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--gold-dark);
    font-weight: 600;
  }

  .how-step .t {
    display: inline-block;
    margin-top: 0.55rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--gold-dark);
    background: var(--gold-wash);
    border-radius: var(--r-pill);
    padding: 0.28rem 0.7rem;
  }

  /* ================= mobile-only step blocks (static this task) ================= */
  .how-mobile {
    display: none;
  }

  @media (max-width: 1023px) {
    .how-grid {
      display: none;
    }

    .how-mobile {
      display: grid;
      gap: 3.5rem;
      padding: 1rem 0 2rem;
    }

    .hm-step {
      display: grid;
      gap: 1rem;
    }

    .hm-media {
      position: relative;
      border-radius: var(--r-md);
      overflow: hidden;
      aspect-ratio: 16 / 10;
      box-shadow: 0 18px 40px oklch(24% 0.02 60 / 0.16);
    }

    .hm-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .hm-media .hm-n {
      position: absolute;
      right: 0.6rem;
      bottom: -1.2rem;
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 300;
      font-size: 5.5rem;
      line-height: 0.8;
      color: var(--gold);
      text-shadow: 0 10px 24px oklch(24% 0.02 60 / 0.3);
    }

    .hm-body .k {
      font-size: 0.7rem;
      letter-spacing: 0.2em;
      color: var(--gold-dark);
      font-weight: 600;
    }

    .hm-body h3 {
      font-size: 1.3rem;
      font-weight: 600;
      margin: 0.3rem 0 0.4rem;
    }

    .hm-body p {
      color: var(--text-secondary);
      font-size: 0.95rem;
    }

    .hm-body .t {
      display: inline-block;
      margin-top: 0.6rem;
      font-size: 0.74rem;
      font-weight: 600;
      color: var(--gold-dark);
      background: var(--gold-wash);
      border-radius: var(--r-pill);
      padding: 0.28rem 0.7rem;
    }
  }

  /* ---- โหมด pin (ทุกความกว้าง, motion allowed): theatrical single-active-step ----
     pin-ready มาจาก editions.ts เท่านั้น (ตอนนี้ทำงานทั้ง full และ lite tier —
     Task 6) ดังนั้น layout ด้านบน (รวม @media (max-width: 1023px) ก่อนหน้านี้)
     ยังเป็นพฤติกรรมพื้นสำหรับทุกกรณีที่ pin ไม่ได้ทำงาน (no-JS, reduced-motion) */
  .how-chapter.pin-ready {
    height: 100svh;
  }

  .how-chapter.pin-ready .how-viewport {
    height: 100%;
    padding: calc(72px + clamp(10px, 2vh, 24px)) clamp(20px, 4vw, 64px);
    justify-content: center;
  }

  .how-chapter.pin-ready .how-grid {
    /* <1024px's own @media block (untouched, above) still forces
       .how-grid to display:none — that rule is the no-JS/reduced-motion
       default and must stay put, but once pin-ready lands (now true at
       every width, Task 6) the pinned collage is what should render, not
       a blank chapter, so pin-ready overrides display back on here */
    display: grid;
    flex: 1 1 auto;
    min-height: 0;
  }

  .how-chapter.pin-ready .how-step {
    opacity: 0.3;
    transition: opacity 0.4s;
  }

  .how-chapter.pin-ready .how-step.on {
    opacity: 1;
  }

  .how-chapter.pin-ready .how-step .t {
    opacity: 0;
    transition: opacity 0.4s;
  }

  .how-chapter.pin-ready .how-step.on .t {
    opacity: 1;
  }

  /* fix round 1 (review): the desktop collage is a two-column layout
     (grid-template-columns: 1.05fr 1fr, above) with a giant numeral
     (.hugely span, clamp min 144px) and three simultaneously-visible steps
     (44ch paragraphs) — none of that survives a 390px column (~165px each
     side). Below 1024px, pin-ready now: stacks to one column, shrinks the
     collage photo + numeral to mobile-appropriate sizes, and shows only the
     active step (the desktop "dim the other two" treatment has no room on a
     phone) so the whole thing fits inside the fixed 100svh pin box instead
     of overflowing past `.how-chapter`'s `overflow: clip`. */
  @media (max-width: 1023px) {
    .how-chapter.pin-ready .how-grid {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }

    .how-chapter.pin-ready .hugely {
      height: 28vh;
    }

    .how-chapter.pin-ready .hugely span {
      font-size: clamp(3.2rem, 16vw, 6rem);
    }

    .how-chapter.pin-ready .how-steps {
      min-height: 0;
    }

    .how-chapter.pin-ready .how-step {
      display: none;
    }

    .how-chapter.pin-ready .how-step.on {
      display: block;
      opacity: 1;
    }

    .how-chapter.pin-ready .how-step.on .t {
      opacity: 1;
    }
  }

  .how-chapter.pin-ready .how-mobile {
    display: none;
  }
</style>

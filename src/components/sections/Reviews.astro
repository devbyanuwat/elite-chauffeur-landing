---
import { getReviews } from '../../lib/reviews-api';
import StaticReviews from './StaticReviews.astro';

const VEH_LABEL: Record<string, string> = {
  sedan: 'รถเก๋ง', suv: 'รถ SUV', van: 'พรีเมียมแวน', mpv: 'พรีเมียมแวน',
};

const reviews = await getReviews();
---

{reviews.length > 0 ? (
  <div class="rev-slider-wrap">
    <div class="rev-track" id="rev-track">
      {reviews.map((r) => (
        <figure class="rev-card">
          {r.carPhotoUrl && <img src={r.carPhotoUrl} alt="รถของคนขับ SABUYGO" loading="lazy" width="320" height="200" />}
          <figcaption>
            <p>&ldquo;{r.comment}&rdquo;</p>
            <span>{r.customerNameMasked} · {VEH_LABEL[r.vehicleType ?? ''] ?? 'บริการโดย SABUYGO'}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <div class="rev-nav">
      <button type="button" class="rev-arrow" data-dir="-1" aria-label="ก่อนหน้า">←</button>
      <button type="button" class="rev-arrow" data-dir="1" aria-label="ถัดไป">→</button>
    </div>
  </div>
) : (
  <StaticReviews />
)}

---
// Curated fallback reviews — shown while the live island loads and whenever BOS
// is unreachable or returns zero. Also the SEO baseline (real curated content).
interface FallbackReview {
  quote: string;
  name: string;
  role: string;
  photo?: string;
}

const FALLBACK: FallbackReview[] = [
  { quote: 'คนขับสุภาพมาก รับตรงเวลา ประทับใจค่ะ', name: 'คุณแน****', role: 'รับส่งสนามบิน', photo: '/images/review-airport-night.webp' },
  { quote: 'พาครอบครัวไปหัวหิน สบายมาก ไม่ต้องเหนื่อยขับเอง', name: 'คุณเอ****', role: 'เช่ารถเที่ยว', photo: '/images/review-family-trip.webp' },
  { quote: 'รถสะอาด คนขับใจดี เด็ก ๆ นั่งสบาย', name: 'คุณพ****', role: 'ทริปครอบครัว', photo: '/images/review-couple-morning.webp' },
  { quote: 'ราคาตามที่แจ้งจริง ไม่บวกเพิ่ม ถูกใจมาก', name: 'คุณว****', role: 'เดินทางธุรกิจ', photo: '/images/review-friends-day.webp' },
  { quote: 'จองง่ายผ่าน LINE ตอบไว ใช้บริการอีกแน่นอน', name: 'คุณม****', role: 'รับส่งสนามบิน', photo: '/images/review-airport-night.webp' },
  { quote: 'ขับนุ่ม ปลอดภัย คุณแม่ชมว่าสบายมาก', name: 'คุณน****', role: 'ทริปครอบครัว', photo: '/images/review-family-trip.webp' },
];
---

<div class="rev-slider-wrap">
  <div class="rev-track" id="rev-track">
    {FALLBACK.map((r) => (
      <figure class="rev-card">
        {r.photo && <img src={r.photo} alt={`ลูกค้า SABUYGO — ${r.role}`} loading="lazy" width="320" height="200" />}
        <figcaption>
          <p>&ldquo;{r.quote}&rdquo;</p>
          <span>{r.name} · {r.role}</span>
        </figcaption>
      </figure>
    ))}
  </div>
  <div class="rev-nav">
    <button type="button" class="rev-arrow" data-dir="-1" aria-label="ก่อนหน้า">←</button>
    <button type="button" class="rev-arrow" data-dir="1" aria-label="ถัดไป">→</button>
  </div>
</div>

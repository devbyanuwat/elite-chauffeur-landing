---
// chapter 3 · routes (ports mockups/pinned-editions.html #routes)
// data-chapter / data-chapter-len is editions.ts's own contract — see
// Fleet.astro's header comment for the full pin-ready/no-JS contract this
// follows. Default (no .pin-ready — no JS, <1024px, or reduced motion)
// renders the track as a plain horizontally-scrollable row (overflow-x:
// auto + scroll-snap), so every card stays reachable without any JS; only
// once .pin-ready lands does the track switch to a pinned, scrub-driven
// horizontal scroll (buildRoutesChapter in editions.ts).
//
// Card data is real, pulled from the same route/airport content this same
// site publishes on its own detail pages — never invented for this mockup
// port:
//   - Bangkok -> Pattaya: src/content/routes/bangkok-to-pattaya.yaml
//     (distanceKm: 147, travelTime: "1.45", startPrice: "฿1,500")
//   - Bangkok -> Hua Hin: src/content/routes/bangkok-to-hua-hin.yaml
//     (distanceKm: 200, travelTime: "3.0", startPrice: "฿2,500")
//   - Suvarnabhumi (BKK): src/content/airports/suvarnabhumi-bkk.yaml
//     (priceLow: "1200", waitMinutes: 60)
interface RouteCard {
  img: string;
  alt: string;
  nameKey: string;
  nameText: string;
  metaKey: string;
  metaText: string;
  price: string;
  href: string;
  assetTodo?: string;
}

const CARDS: RouteCard[] = [
  {
    img: '/images/parallax/close/color.webp',
    alt: 'เช่ารถพร้อมคนขับ เส้นทางกรุงเทพฯ ไปพัทยา',
    nameKey: 'rt.pattaya.name',
    nameText: 'กรุงเทพ → พัทยา',
    metaKey: 'rt.pattaya.meta',
    metaText: '147 กม. · ~1.45 ชม.',
    price: '฿1,500',
    href: '/routes/bangkok-to-pattaya/',
  },
  {
    img: '/images/parallax/service/rental/color.webp',
    alt: 'เช่ารถพร้อมคนขับ เส้นทางกรุงเทพฯ ไปหัวหิน',
    nameKey: 'rt.huahin.name',
    nameText: 'กรุงเทพ → หัวหิน',
    metaKey: 'rt.huahin.meta',
    metaText: '200 กม. · ~3 ชม.',
    price: '฿2,500',
    href: '/routes/bangkok-to-hua-hin/',
    assetTodo: 'generate clean hua-hin scene via gen-media',
  },
  {
    img: '/images/parallax/airport/color.webp',
    alt: 'บริการรับส่งสนามบินสุวรรณภูมิ พร้อมคนขับ',
    nameKey: 'rt.bkk',
    nameText: 'สุวรรณภูมิ (BKK)',
    metaKey: 'rt.bkk.m',
    metaText: 'รับส่ง 24 ชม.',
    price: '฿1,200',
    href: '/airport-transfer/suvarnabhumi-bkk/',
  },
  {
    img: '/images/parallax/hero/color.webp',
    alt: 'เส้นทางอื่น ๆ เขาใหญ่ กาญจนบุรี อยุธยา',
    nameKey: 'rt.other.name',
    nameText: 'เส้นทางอื่น ๆ',
    metaKey: 'rt.other.meta',
    metaText: 'เขาใหญ่ · กาญจนบุรี · อยุธยา',
    price: 'สอบถาม',
    href: '#booking',
  },
];
---

<section class="chapter routes-chapter" id="routes" data-chapter="routes" data-chapter-len="360">
  <div class="routes-viewport">
    <div class="ch-head">
      <div>
        <span class="ch-eyebrow" data-i18n="rt.eyebrow">เส้นทางยอดนิยม</span>
        <h2 class="ch-title" data-i18n="rt.title">ออกจากกรุงเทพฯ ไปได้ทุกที่</h2>
      </div>
    </div>

    <div class="track-clip">
      <div class="track" id="route-track">
        {CARDS.map((card) => (
          <a class="route-card" href={card.href}>
            {card.assetTodo && <Fragment set:html={`<!-- TODO(asset): ${card.assetTodo} -->`} />}
            <img src={card.img} alt={card.alt} width="680" height="425" loading="lazy" />
            <div class="veil"></div>
            <div class="info">
              <div>
                <h3 data-i18n={card.nameKey}>{card.nameText}</h3>
                <div class="m" data-i18n={card.metaKey}>{card.metaText}</div>
              </div>
              <b>{card.price}</b>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="routes-foot">
      <div class="hint" data-i18n="rt.hint">เลื่อนเพื่อดูเส้นทาง</div>
      <div class="rprog"><i id="route-prog"></i></div>
    </div>
  </div>
</section>

<style>
  .routes-chapter {
    position: relative;
    overflow: clip;
    background: var(--bg-dark);
    color: oklch(94% 0.01 80);
  }

  .routes-chapter .ch-title {
    color: oklch(97% 0.006 80);
  }

  .routes-chapter .ch-eyebrow {
    color: var(--gold-light);
  }

  .routes-viewport {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: clamp(20px, 5vw, 32px);
  }

  .ch-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .ch-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .ch-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    margin-top: 0.35rem;
  }

  /* base / no-JS / <1024px: a plain horizontally-scrollable row — every card
     stays reachable without buildRoutesChapter ever attaching (matches the
     mockup's own <1024px override, but used here as the universal default
     so desktop-without-motion gets the same guarantee). */
  .track-clip {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .track-clip::-webkit-scrollbar {
    display: none;
  }

  .track {
    display: flex;
    gap: clamp(1.2rem, 2.5vw, 2.2rem);
    padding-inline: clamp(20px, 4vw, 64px);
  }

  .route-card {
    position: relative;
    flex: 0 0 84vw;
    scroll-snap-align: center;
    aspect-ratio: 16 / 10;
    border-radius: 6px;
    overflow: hidden;
    background: #111;
    color: inherit;
  }

  .route-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.12);
    will-change: transform;
    opacity: 0.85;
  }

  .route-card .veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 18%, oklch(15% 0.02 235 / 0.55) 55%, oklch(12% 0.02 235 / 0.94));
  }

  .route-card .info {
    position: absolute;
    left: 1.4rem;
    right: 1.4rem;
    bottom: 1.2rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .route-card .info h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.3rem, 2.2vw, 1.9rem);
    color: oklch(97% 0.006 80);
    text-shadow: 0 1px 14px oklch(12% 0.02 235 / 0.7);
  }

  .route-card .info .m {
    font-size: 0.78rem;
    color: oklch(86% 0.008 80);
    text-shadow: 0 1px 10px oklch(12% 0.02 235 / 0.7);
    margin-top: 0.25rem;
  }

  .route-card .info b {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    color: var(--sun);
  }

  .routes-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid oklch(35% 0.02 235);
  }

  .routes-foot .hint {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: oklch(65% 0.01 80);
  }

  .rprog {
    width: 180px;
    height: 1px;
    background: oklch(35% 0.02 235);
    position: relative;
  }

  .rprog i {
    position: absolute;
    inset: 0;
    background: var(--gold-light);
    transform-origin: left;
    transform: scaleX(0);
  }

  /* desktop default (no pin-ready): wider cards, still a plain scrollable
     row so this is usable with JS disabled / reduced motion / <1024px gate
     not yet firing — "nothing hidden" default the brief calls for */
  @media (min-width: 1024px) {
    .route-card {
      flex: 0 0 min(58vw, 680px);
    }
  }

  /* mobile-only guard: unconditional so it holds regardless of .pin-ready
     (fix-review precedent from Fleet.astro's finding 1 — a viewport-scoped
     override must never depend on a JS-added class to take effect) */
  @media (max-width: 1023.98px) {
    .track {
      transform: none !important;
    }
  }

  /* ---- โหมด pin (desktop, motion allowed) ----
     pin-ready มาจาก editions.ts เท่านั้น — layout ด้านบนยังเป็นพฤติกรรมพื้น
     สำหรับทุกกรณีที่ pin ไม่ได้ทำงาน */
  @media (min-width: 1024px) {
    .routes-chapter.pin-ready {
      height: 100vh;
    }

    .routes-chapter.pin-ready .routes-viewport {
      height: 100%;
      padding: clamp(16px, 3vh, 40px) clamp(20px, 4vw, 64px);
    }

    .routes-chapter.pin-ready .track-clip {
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      align-items: center;
      overflow: hidden;
      scroll-snap-type: none;
    }

    .routes-chapter.pin-ready .route-card {
      scroll-snap-align: none;
    }
  }
</style>

---

<section class="block" id="routes" data-pin="route" data-pin-length="240">
  <div class="wrap wrap-wide">
    <div class="section-head reveal">
      <span class="eyebrow" data-i18n="rt.eyebrow">เส้นทางยอดนิยม</span>
      <h2 data-i18n="rt.title">ปลายทางที่ลูกค้าเลือกบ่อย</h2>
      <p data-i18n="rt.sub">เส้นทางในเมืองและต่างจังหวัด พร้อมคนขับที่รู้ทางเป็นอย่างดี</p>
    </div>
    <div class="routes-grid">
      <svg class="route-line" viewBox="0 0 1200 240" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path data-draw d="M40 200 C 300 200, 340 40, 600 40 S 900 200, 1160 60" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <a class="route-card reveal" data-stage="0" href="airport-transfer/suvarnabhumi-bkk/">
        <img src="/images/service1.webp" alt="บริการรับส่งสนามบินสุวรรณภูมิ พร้อมคนขับ" width="400" height="533" loading="lazy">
        <div class="route-body">
          <span class="kicker" data-i18n="rt.airport">สนามบิน</span>
          <h3 data-i18n="rt.bkk">สุวรรณภูมิ (BKK)</h3>
          <div class="route-meta"><span data-i18n="rt.bkk.m">รับส่ง 24 ชม.</span></div>
        </div>
      </a>
      <a class="route-card reveal" data-stage="1" href="routes/bangkok-to-pattaya/">
        <img src="/images/service-business.webp" alt="เช่ารถพร้อมคนขับ เส้นทางกรุงเทพฯ ไปพัทยา" width="400" height="533" loading="lazy">
        <div class="route-body">
          <span class="kicker" data-i18n="rt.trip">เที่ยวต่างจังหวัด</span>
          <h3 data-i18n="rt.pattaya">พัทยา</h3>
          <div class="route-meta"><span>~147 กม.</span><span>~2 ชม.</span></div>
        </div>
      </a>
      <a class="route-card reveal" data-stage="2" href="routes/bangkok-to-hua-hin/">
        <img src="/images/service2.webp" alt="เช่ารถพร้อมคนขับ เส้นทางกรุงเทพฯ ไปหัวหิน" width="400" height="533" loading="lazy">
        <div class="route-body">
          <span class="kicker" data-i18n="rt.trip">เที่ยวต่างจังหวัด</span>
          <h3 data-i18n="rt.huahin">หัวหิน</h3>
          <div class="route-meta"><span>~200 กม.</span><span>~2.5 ชม.</span></div>
        </div>
      </a>
      <a class="route-card reveal" data-stage="3" href="airport-transfer/don-mueang-dmk/">
        <img src="/images/service3.webp" alt="บริการรับส่งสนามบินดอนเมือง พร้อมคนขับ" width="400" height="533" loading="lazy">
        <div class="route-body">
          <span class="kicker" data-i18n="rt.airport">สนามบิน</span>
          <h3 data-i18n="rt.dmk">ดอนเมือง (DMK)</h3>
          <div class="route-meta"><span data-i18n="rt.dmk.m">รับส่ง 24 ชม.</span></div>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  /* final-review I1 fix: this used to be an inline `style="padding-top:0"`
     on the section, which no ordinary stylesheet selector can beat short of
     `!important`. Moved here as a plain `#routes` rule instead — an id
     selector already outranks the shared `section.block` class+type rule
     below (see global.css) that sets `padding-block`, so this reproduces the
     exact prior default (non-pinned) spacing with no specificity war. */
  #routes {
    padding-top: 0;
  }

  .routes-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.1rem;
  }

  .route-card {
    position: relative;
    aspect-ratio: 3 / 4;
    border-radius: var(--r-lg);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    color: #fff;
    isolation: isolate;
    transition: transform 0.35s var(--ease-out);
  }

  .route-card:hover {
    transform: translateY(-5px);
  }

  .route-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    /* unify mixed photo tones into one warm direction */
    filter: saturate(0.95) sepia(0.1);
    transition: transform 0.5s var(--ease-out);
  }

  .route-card:hover img {
    transform: scale(1.06);
  }

  .route-card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, oklch(20% 0.02 235 / 0) 35%, oklch(18% 0.02 235 / 0.85) 100%);
  }

  .route-body {
    padding: 1.2rem;
  }

  .route-body .kicker {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .route-body h3 {
    color: #fff;
    font-size: 1.3rem;
    margin: 0.3rem 0 0.5rem;
  }

  .route-meta {
    display: flex;
    gap: 0.9rem;
    font-size: 0.78rem;
    opacity: 0.92;
  }

  .route-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  /* เส้นทางมีความหมายเฉพาะตอนที่มีอะไรมาวาดมัน จึงซ่อนเป็นค่าเริ่มต้น */
  .route-line {
    display: none;
  }

  /* ---- โหมด pin (desktop, motion allowed) ----
     final-review C1 fix: same treatment as Fleet.astro — GSAP's pin freezes
     the section's own natural height and holds it fixed at the viewport top,
     so that natural height must fit in one viewport with margin to spare
     (Routes measured only 13px of headroom at 1366×768 before this fix, so a
     longer English heading could push it over). The whole pinned section is
     forced to exactly one viewport tall and that height is distributed with
     flexbox — padding and heading take their natural size, the grid fills
     the rest. Unlike Fleet, the vehicle/destination photo here is already an
     absolutely-positioned cover background inside `.route-card` (not a
     sibling that competes for height), so the card itself can simply be
     `height: 100%` with no separate flex child to make elastic — the image
     crops via `object-fit: cover`, which is already how it behaves at every
     other size. This also gives `#routes` real top clearance under the fixed
     nav (final-review I1), applied only while pinned so the non-pinned
     `padding-top: 0` above is untouched.

     The 100vh is trimmed by an extra 50px for the same measured reason as
     Fleet.astro's identical comment: pin.ts's crossfade `scale` (0.97 → 1 →
     1.03 on the [data-stage] element) stacks on a translateY(24px) GSAP
     bakes in the first time it touches `transform`, captured from
     `.reveal`'s pre-reveal state before `legacy-reveal.ts` can add `.in`.
     50px covers the measured ~31px worst case with margin, without touching
     pin.ts or legacy-reveal.ts (out of scope here). */
  #routes.pin-ready {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 50px);
    padding-block: 0;
  }

  #routes.pin-ready .wrap {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    padding-top: max(84px, 6vh);
    padding-bottom: clamp(20px, 4vh, 40px);
  }

  #routes.pin-ready .section-head {
    flex: none;
    margin-bottom: clamp(16px, 3vh, 32px);
  }

  #routes.pin-ready .routes-grid {
    display: block;
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
  }

  #routes.pin-ready .route-line {
    display: block;
    position: absolute;
    inset: auto 0 8%;
    width: 100%;
    height: 30%;
    color: color-mix(in oklab, var(--gold), transparent 45%);
    pointer-events: none;
  }

  #routes.pin-ready .route-card {
    position: absolute;
    inset: 0;
    margin-inline: auto;
    width: min(100%, 520px);
    height: 100%;
    aspect-ratio: auto;
  }

  /* hover lift เดิมชน transform ที่ scrub คุมอยู่ */
  #routes.pin-ready .route-card:hover {
    transform: none;
  }

  @media (max-width: 880px) {
    .routes-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .routes-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

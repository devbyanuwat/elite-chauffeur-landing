---
// chapter 1 · fleet (ports mockups/pinned-editions.html #fleet)
// data-chapter / data-chapter-len is editions.ts's own contract — separate
// from pin.ts's data-pin/data-stage. Default (no .pin-ready — no JS, <1024px,
// or reduced motion) renders as a plain block layout with the Alphard card
// (stage 0) fully visible; ghost word + car image only overlap absolutely
// once .pin-ready is present, same as the mockup's base (non-media) rules.
//
// vtype MUST be a key of the verified VT_API map in BookingForm.astro
// ('sedan' | 'suv' | 'premium' | 'any') — Alphard -> premium,
// Fortuner/Xpander -> suv, Altis -> sedan.
// fix-review finding 2: chips used to be plain Thai strings written straight
// into innerHTML on every stage change (JS-only, no data-i18n) — after
// toggling to EN, a fleet stage change would snap the chips back to Thai.
// Each chip now carries its own i18n key; the visible chips AND every car's
// chip set in the hidden #fleet-chip-bank below all render with data-i18n, so
// setLang's normal [data-i18n] sweep keeps them localized regardless of which
// car is on screen or when the toggle happens relative to a stage swap.
interface Chip {
  text: string;
  key: string;
}

interface Car {
  ghost: string;
  name: string;
  price: string;
  chips: Chip[];
  img: string;
  alt: string;
  vtype: 'sedan' | 'suv' | 'premium';
}

const SEAT7: Chip = { text: '7 ที่นั่ง', key: 'fl.chip.seat7' };
const SEAT4: Chip = { text: '4 ที่นั่ง', key: 'fl.chip.seat4' };
const AUTO: Chip = { text: 'เกียร์ออโต้', key: 'fl.chip.auto' };
const INSURED: Chip = { text: 'ประกันเต็มคัน', key: 'fl.chip.insured' };
const VIP: Chip = { text: 'VIP', key: 'fl.chip.vip' };

const CARS: Car[] = [
  {
    ghost: 'ALPHARD',
    name: 'Toyota Alphard',
    price: '฿1,000',
    chips: [SEAT7, AUTO, INSURED, VIP],
    img: '/images/car2.webp',
    alt: 'Toyota Alphard',
    vtype: 'premium',
  },
  {
    ghost: 'FORTUNER',
    name: 'Toyota Fortuner',
    price: '฿500',
    chips: [SEAT7, AUTO, INSURED],
    img: '/images/car3.webp',
    alt: 'Toyota Fortuner Legender',
    vtype: 'suv',
  },
  {
    ghost: 'XPANDER',
    name: 'Mitsubishi Xpander',
    price: '฿450',
    chips: [SEAT7, AUTO, INSURED],
    img: '/images/car1.webp',
    alt: 'Mitsubishi Xpander Cross',
    vtype: 'suv',
  },
  {
    ghost: 'ALTIS',
    name: 'Toyota Corolla Altis',
    price: '฿400',
    chips: [SEAT4, AUTO, INSURED],
    img: '/images/car4.webp',
    alt: 'Toyota Corolla Altis',
    vtype: 'sedan',
  },
];

const first = CARS[0];
---

<section class="chapter fleet-chapter" id="fleet" data-chapter="fleet" data-chapter-len="380">
  <div class="fleet-viewport">
    <div class="ch-head">
      <div>
        <span class="ch-eyebrow" data-i18n="fl.eyebrow">รถของเรา</span>
        <h2 class="ch-title" data-i18n="fl.title">เลือกรถที่ใช่ สำหรับทุกการเดินทาง</h2>
      </div>
      <div class="ch-eyebrow fleet-count">01 / 0{CARS.length}</div>
    </div>

    <nav class="rail" aria-hidden="true">
      {CARS.map((c, i) => (
        <button type="button" class={i === 0 ? 'on' : ''}>
          <span class="idx">0{i + 1}</span><span class="bar"><i></i></span><span class="lbl">{c.ghost}</span>
        </button>
      ))}
    </nav>

    <div class="fleet-stagewrap">
      <div class="ghost"><span>{first.ghost}</span></div>
      <div class="car-layer">
        <img src={first.img} alt={first.alt} width="600" height="375" loading="eager" />
      </div>
    </div>

    <div class="fleet-tabs">
      {CARS.map((_c, i) => (
        <button type="button" class={i === 0 ? 'on' : ''} aria-label={`รถคันที่ ${i + 1}`}>{i + 1}</button>
      ))}
    </div>

    <div class="fleet-meta">
      <div>
        <div class="name">{first.name}</div>
        <div class="chips">
          {first.chips.map((chip) => <span class="chip" data-i18n={chip.key}>{chip.text}</span>)}
        </div>
      </div>
      <div class="price">
        <small data-i18n="fl.from">เริ่มต้น</small><br />
        <b>{first.price}</b><small data-i18n="fl.day">/วัน</small>
        <div>
          <button type="button" class="pick" data-vtype={first.vtype}>
            <span data-i18n="fl.book">เลือกคันนี้</span> →
          </button>
        </div>
      </div>
    </div>

    <!-- fix-review finding 2: hidden per-car chip sets, each chip carrying its
         own data-i18n key. buildFleetChapter() / the mobile tab script below
         clone `[data-car-index]`'s CURRENT innerHTML (post-toggle, if any)
         into the visible .chips container instead of writing car.chips text
         directly — that's how a stage swap after an EN toggle stays in
         English instead of reverting to the Thai literal. -->
    <div id="fleet-chip-bank" hidden aria-hidden="true">
      {CARS.map((c, i) => (
        <div data-car-index={i}>
          {c.chips.map((chip) => <span class="chip" data-i18n={chip.key}>{chip.text}</span>)}
        </div>
      ))}
    </div>

    <script
      type="application/json"
      id="fleet-data"
      set:html={JSON.stringify(CARS.map(({ ghost, name, price, img, alt, vtype }) => ({ ghost, name, price, img, alt, vtype })))}
    />
  </div>
</section>

<style>
  .fleet-chapter {
    position: relative;
    overflow: clip;
    background:
      radial-gradient(120% 100% at 70% 30%, oklch(99% 0.004 90), transparent 60%),
      var(--bg-secondary);
  }

  .fleet-viewport {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: clamp(20px, 5vw, 32px);
  }

  .ch-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .ch-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold-dark);
    font-weight: 600;
  }

  .ch-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    margin-top: 0.35rem;
  }

  .fleet-count {
    white-space: nowrap;
  }

  /* belt-and-suspenders on top of the [hidden] attribute — this bank only
     ever exists to be read from (querySelector), never to be seen */
  #fleet-chip-bank {
    display: none;
  }

  /* left rail — Editions-style chapter progress; scroll-jump only works once
     buildFleetChapter() has attached click handlers, but showing it inert is
     harmless (matches the mockup, which never gates its visibility on JS) */
  .rail {
    position: absolute;
    left: clamp(20px, 4vw, 64px);
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    z-index: 5;
  }

  .rail button {
    all: unset;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--text-tertiary);
    transition: color 0.3s;
  }

  .rail .idx {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-style: italic;
  }

  .rail .bar {
    width: 26px;
    height: 1px;
    background: var(--border);
    position: relative;
    overflow: hidden;
  }

  .rail .bar i {
    position: absolute;
    inset: 0;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .rail button.on {
    color: var(--text-primary);
  }

  .rail button.on .bar i {
    transform: scaleX(1);
  }

  .rail .lbl {
    opacity: 0;
    transform: translateX(-6px);
    transition: 0.35s;
  }

  .rail button.on .lbl {
    opacity: 1;
    transform: none;
  }

  /* ghost word + car image overlap by design at every breakpoint (matches the
     mockup's base, non-media .ghost/.car-layer rules) — the giant ghost word
     sits behind, the car photo paints over it because it comes later in the
     DOM. This is also the complete no-JS/stage-0 default. */
  .fleet-stagewrap {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 44svh;
  }

  .ghost {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    overflow: hidden;
  }

  .ghost span {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(3.6rem, 16vw, 6rem);
    letter-spacing: 0.02em;
    color: oklch(90% 0.03 60 / 0.55);
    white-space: nowrap;
    line-height: 1;
  }

  .car-layer {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .car-layer img {
    width: 88vw;
    max-height: 38svh;
    object-fit: contain;
    filter: drop-shadow(0 30px 40px oklch(24% 0.02 60 / 0.18));
  }

  /* mobile-only numbered tabs — tap to swap car; wired by this component's
     own plain-JS script below (buildFleetChapter never runs <1024px) */
  .fleet-tabs {
    display: flex;
    gap: 0.5rem;
    padding: 0 0 0.2rem;
  }

  .fleet-tabs button {
    all: unset;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--text-tertiary);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .fleet-tabs button.on {
    color: var(--gold-dark);
    border-color: var(--gold);
  }

  .fleet-meta {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    border-top: 1px solid var(--border);
    padding-top: 1.1rem;
  }

  .fleet-meta .name {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 400;
  }

  .chips {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .chip {
    font-size: 0.72rem;
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    padding: 0.3rem 0.7rem;
    color: var(--text-secondary);
    background: var(--bg-primary);
  }

  .price small {
    color: var(--text-tertiary);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  .price b {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    font-weight: 400;
    color: var(--gold-dark);
  }

  .pick {
    all: unset;
    display: inline-block;
    margin-top: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-primary);
    border-bottom: 1px solid var(--gold);
    padding-bottom: 2px;
    cursor: pointer;
  }

  /* rail is Editions-only chrome — the mockup itself hides it below 1024px */
  @media (max-width: 1023px) {
    .rail {
      display: none;
    }
  }

  /* fix-review finding 1: the mobile numbered tabs must disappear at >=1024px
     unconditionally — not only once buildFleetChapter() attaches .pin-ready.
     Gating this on .pin-ready left the pills visible on desktop whenever JS
     never runs (prefers-reduced-motion, JS disabled, or the matchMedia gate
     in motion/index.ts simply hasn't fired yet), same failure mode the
     mockup avoids by hiding `.fleet-tabs` unconditionally above 1023px. */
  @media (min-width: 1024px) {
    .fleet-tabs {
      display: none;
    }
  }

  /* ---- โหมด pin (ทุกความกว้าง, motion allowed) ----
     pin-ready มาจาก editions.ts เท่านั้น (ตอนนี้ทำงานทั้ง full และ lite tier —
     Task 6) ดังนั้น layout ด้านบนยังเป็นพฤติกรรมพื้นสำหรับทุกกรณีที่ pin ไม่ได้ทำงาน */
  .fleet-chapter.pin-ready {
    height: 100svh;
  }

  .fleet-chapter.pin-ready .fleet-viewport {
    height: 100%;
    /* nav ลอย fixed สูง 72px — บทที่ pin เต็มจอต้องเผื่อหัว ไม่งั้นชื่อบทมุดใต้ nav */
    padding: calc(72px + clamp(10px, 2vh, 24px)) clamp(20px, 4vw, 64px) clamp(16px, 3vh, 40px);
  }

  .fleet-chapter.pin-ready .fleet-stagewrap {
    flex: 1 1 auto;
    min-height: 0;
  }

  .fleet-chapter.pin-ready .car-layer img {
    width: min(62vw, 860px);
    max-height: 52vh;
  }

  /* fix round 1 (review): clamp's own min (6rem = 96px) already blows past a
     390px phone's ~350px-wide, overflow:hidden .ghost box (17vw alone is
     ~66px there, so the 6rem floor — not the vw term — was what clipped
     "ALPHARD" on both sides). Below 1024px fall back to the base rule's own
     3.6rem/30vh sizing (same clamp shape as .hugely span in How.astro) —
     the >=1024px block below restores the desktop-sized numeral. */
  .fleet-chapter.pin-ready .ghost span {
    font-size: clamp(2.6rem, 13vw, 6rem);
  }

  @media (min-width: 1024px) {
    .fleet-chapter.pin-ready .ghost span {
      font-size: clamp(6rem, 17vw, 15rem);
    }

    /* fix round 1 (review): row + the 220px CTA-clearance padding + right-
       aligned price only make sense once there's enough width for name/price
       to sit side by side — 220px alone leaves ~130px on a 390px phone for
       two text blocks. Below 1024px .fleet-meta/.price keep the column
       layout their unconditional base rules (above) already define. */
    .fleet-chapter.pin-ready .fleet-meta {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
      /* กันราคาชนปุ่มลอยมุมขวาล่าง (sticky CTA + LINE) */
      padding-right: 220px;
    }

    .fleet-chapter.pin-ready .price {
      text-align: right;
    }
  }
</style>

<script>
  (function () {
    'use strict';

    /* ---------- Fleet mobile tabs -> stage swap (plain JS, no GSAP) ----------
       buildFleetChapter() in editions.ts now attaches under EITHER matchMedia
       gate (full tier >=1024px, or lite tier <1024px — Task 6), and once it
       does it adopts these same `.fleet-tabs button` elements into its own
       click→scrollTo wiring (see chapters/fleet.ts's `railButtons` query).
       Without a guard here both controllers would fire on the same click:
       this fallback's instant DOM write AND the chapter's scroll (which
       itself re-drives the DOM via onUpdate) — a redundant, flicker-prone
       double-update, not a broken one, but the fix-round-1 review flagged
       exactly this "two controllers" shape and asked for it resolved.
       `.pin-ready` is this component's own contract for "buildFleetChapter
       has attached" (see chapters/fleet.ts's `section.classList.add`), so
       checking it here is the same signal every chapter's CSS already uses
       — when it's present, defer entirely; when it's absent (no-JS,
       reduced-motion, or the matchMedia gate simply hasn't fired yet), this
       remains the only working control, same as before Task 6. */
    var section = document.getElementById('fleet');
    if (!section) return;

    var dataEl = document.getElementById('fleet-data');
    var cars: { ghost: string; name: string; price: string; img: string; alt: string; vtype: string }[] = [];
    try {
      var parsed = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
      if (Array.isArray(parsed)) cars = parsed;
    } catch (err) {
      cars = [];
    }

    var ghostSpan = section.querySelector('.ghost span');
    var carImg = section.querySelector('.car-layer img') as HTMLImageElement | null;
    var nameEl = section.querySelector('.fleet-meta .name');
    var chipsEl = section.querySelector('.fleet-meta .chips');
    var priceEl = section.querySelector('.fleet-meta .price b');
    var pickBtn = section.querySelector('.pick') as HTMLElement | null;
    var countEl = section.querySelector('.fleet-count');
    var tabButtons = section.querySelectorAll('.fleet-tabs button');

    function applyStage(i: number) {
      var car = cars[i];
      if (!car || !ghostSpan || !carImg || !nameEl || !chipsEl || !priceEl) return;

      ghostSpan.textContent = car.ghost;
      carImg.src = car.img;
      carImg.alt = car.alt;
      nameEl.textContent = car.name;
      priceEl.textContent = car.price;
      // fix-review finding 2: clone the current (possibly already-toggled)
      // localized markup from the hidden bank instead of writing the raw
      // Thai chip text — see #fleet-chip-bank's comment above.
      var bankEntry = document.querySelector('#fleet-chip-bank [data-car-index="' + i + '"]');
      chipsEl.innerHTML = bankEntry ? bankEntry.innerHTML : '';
      if (pickBtn) pickBtn.setAttribute('data-vtype', car.vtype);
      if (countEl) countEl.textContent = '0' + (i + 1) + ' / 0' + cars.length;

      tabButtons.forEach(function (b, j) {
        b.classList.toggle('on', j === i);
      });
    }

    tabButtons.forEach(function (btn, i) {
      btn.addEventListener('click', function () {
        if (section!.classList.contains('pin-ready')) return;
        applyStage(i);
      });
    });

    /* ---------- Fleet "choose this car" -> prefill + scroll ----------
       Live behaviour called selectVtype() directly (single-file script scope).
       Here that function lives inside ServiceTabs.astro's own scoped <script>
       module and is not exported, so this component reaches the booking form
       through the same shared DOM ids (.vtype-chip / #vehicleType) instead —
       the "shared DOM ids" integration point established in BookingForm.astro
       (Task 5). This reproduces selectVtype()'s exact DOM effect (chip active
       state + hidden input value) before scrolling to #booking. The vtype read
       here is always the *currently displayed* car's — desktop's
       buildFleetChapter() and the mobile tabs above both keep .pick's
       data-vtype in sync with whichever stage is on screen. */
    if (pickBtn) {
      pickBtn.addEventListener('click', function () {
        var value = pickBtn!.getAttribute('data-vtype') || 'any';
        var chips = document.querySelectorAll('.vtype-chip');
        var vtypeInput = document.getElementById('vehicleType') as HTMLInputElement | null;
        chips.forEach(function (c) {
          var on = (c as HTMLElement).dataset.value === value;
          c.classList.toggle('active', on);
          c.setAttribute('aria-checked', on ? 'true' : 'false');
        });
        if (vtypeInput) vtypeInput.value = value;

        var booking = document.getElementById('booking');
        if (booking) {
          var y = booking.getBoundingClientRect().top + window.scrollY - 88;
          window.scrollTo({ top: y, behavior: 'auto' });
        }
        var pickup = document.getElementById('b_pickup') as HTMLInputElement | null;
        if (pickup) pickup.focus();
      });
    }
  })();
</script>

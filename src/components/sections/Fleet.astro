<section class="block fleet-section" id="fleet" data-pin="fleet" data-pin-length="240">
  <div class="wrap wrap-wide">
    <div class="section-head center reveal">
      <span class="eyebrow" data-i18n="fl.eyebrow">รถของเรา</span>
      <h2 data-i18n="fl.title">เลือกรถที่ใช่ สำหรับทุกการเดินทาง</h2>
      <p data-i18n="fl.sub">รถใหม่ ดูแลสะอาด ประกันเต็มทุกคัน ราคาเริ่มต้นโปร่งใส</p>
    </div>
    <div class="fleet-grid">
      <article class="fleet-card featured reveal" data-stage="0">
        <div class="fleet-stage">
          <span class="fleet-tag" data-i18n="fl.cat.vip">VIP</span>
          <span class="fleet-flag" data-i18n="fl.popular">ยอดนิยม</span>
          <img class="fleet-img" src="/images/car2.webp" alt="Toyota Alphard" width="600" height="480" loading="lazy">
        </div>
        <div class="fleet-body">
          <h3>Toyota Alphard</h3>

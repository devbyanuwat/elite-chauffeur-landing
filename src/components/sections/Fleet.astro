        </div>
        <div class="fleet-body">
          <h3>Toyota Corolla Altis</h3>
          <div class="fleet-specs">
            <span class="fleet-spec"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>4&nbsp;<span data-i18n="fl.seat">ที่นั่ง</span></span>

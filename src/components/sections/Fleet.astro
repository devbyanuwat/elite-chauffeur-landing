            <span class="fleet-spec"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>7&nbsp;<span data-i18n="fl.seat">ที่นั่ง</span></span>
            <span class="fleet-spec"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.2"/><path d="M12 3.5v6M5.2 18.2l4.3-3M18.8 18.2l-4.3-3"/></svg><span data-i18n="fl.auto">เกียร์ออโต้</span></span>
            <span class="fleet-spec"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg><span data-i18n="fl.insured">ประกันเต็มคัน</span></span>
          </div>
          <div class="fleet-foot">
            <div class="fleet-price"><small data-i18n="fl.from">เริ่มต้น</small><b>฿450</b><small data-i18n="fl.day">/วัน</small></div>

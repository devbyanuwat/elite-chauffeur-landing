</section>

<style>
  .fleet-section {
    background: var(--bg-secondary);
  }

  .fleet-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .fleet-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out), border-color 0.3s;
  }

  .fleet-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
  }

  .fleet-card.featured {
    border-color: color-mix(in oklab, var(--gold), transparent 50%);
  }

  .fleet-stage {
    position: relative;
    aspect-ratio: 5 / 4;
    display: grid;
    place-items: center;
    padding: 1.5rem 1.1rem 1.1rem;
    background: radial-gradient(120% 92% at 50% 26%, oklch(99.5% 0.003 90) 0%, var(--bg-secondary) 78%);
    overflow: hidden;
  }

  .fleet-stage::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 15%;
    width: 68%;
    height: 14px;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, oklch(24% 0.02 60 / 0.26), transparent 70%);
    filter: blur(4px);
    transition: width 0.4s var(--ease-out), opacity 0.4s var(--ease-out);
    z-index: 0;
  }

  .fleet-card:hover .fleet-stage::after {
    width: 78%;
    opacity: 0.75;
  }

  .fleet-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.45s var(--ease-out);
  }

  .fleet-card:hover .fleet-img {
    transform: translateY(-6px) scale(1.04);
  }

  .fleet-tag {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    z-index: 2;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.28rem 0.62rem;
    border-radius: var(--r-pill);
    background: var(--bg-card);
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }

  .fleet-flag {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    z-index: 2;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.28rem 0.62rem;
    border-radius: var(--r-pill);
    background: var(--sun);
    color: var(--bg-dark);
  }

  .fleet-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.15rem 1.3rem 1.4rem;
    border-top: 1px solid var(--border);
  }

  .fleet-body h3 {
    font-size: 1.15rem;
    margin: 0;
  }

  .fleet-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .fleet-spec {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.73rem;
    color: var(--text-secondary);
    background: var(--bg-primary);
    border: 1px solid var(--border);
    border-radius: var(--r-pill);
    padding: 0.22rem 0.55rem;
  }

  .fleet-spec svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    color: var(--text-tertiary);
  }

  .fleet-foot {
    margin-top: auto;
    padding-top: 0.95rem;
    border-top: 1px dashed var(--border);
  }

  .fleet-price {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-bottom: 0.9rem;
  }

  .fleet-price small {
    font-size: 0.72rem;
    color: var(--text-tertiary);
  }

  .fleet-price b {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 600;
    color: var(--gold-dark);
  }

  .fleet-book {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-family: var(--font);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--gold-dark);
    background: var(--gold-wash);
    border: 1.5px solid transparent;
    border-radius: var(--r-pill);
    padding: 0.72rem 1rem;
    cursor: pointer;
    transition: background 0.25s, color 0.25s, transform 0.2s;
  }

  .fleet-book svg {
    width: 15px;
    height: 15px;
    transition: transform 0.25s var(--ease-out);
  }

  .fleet-book:hover {
    background: var(--gold-dark);
    color: #fff;
    transform: translateY(-1px);
  }

  .fleet-book:hover svg {
    transform: translateX(3px);
  }

  .fleet-book:active {
    transform: translateY(0) scale(0.985);
    transition-duration: 0.1s;
  }

  /* ---- โหมด pin (desktop, motion allowed) ----
     pin-ready มาจาก pin.ts เท่านั้น ดังนั้น grid 4 คอลัมน์ด้านบนยังเป็น
     พฤติกรรมพื้นสำหรับทุกกรณีที่ pin ไม่ได้ทำงาน

     final-review C1 fix: GSAP's pin freezes the *section*'s own natural
     (pre-pin) height and holds it fixed at the viewport top for the whole
     scroll-driven sequence — anything below that frozen height is
     unreachable, because the section itself owns the scroll, not its
     content. The old rule sized the image with a fixed aspect-ratio
     (5/4 at up to 560px wide = 448px) and let the card be as tall as
     fit-content demanded, with no tie to the viewport that has to hold it.
     Below, the whole pinned section is exactly one viewport tall and that
     height is distributed with flexbox: padding and the heading claim their
     own natural size first, the card fills what's left, and *inside* the
     card the image (.fleet-stage) is the flexible remainder while the
     price/CTA (.fleet-body) keep their natural, unshrunk size. A longer
     heading (e.g. an English line-wrap) only leaves less room for the
     image — it can never push the total past 100vh.

     The 100vh is trimmed by an extra 50px, not just a rounding hair: measured
     in a real browser, the active/incoming stage's own crossfade transform
     (pin.ts tweens `scale` 0.97 → 1 → 1.03 on the [data-stage] element itself)
     stacks on top of a translateY(24px) that GSAP bakes in permanently the
     first time it touches `transform` — captured from `.reveal`'s pre-reveal
     CSS state (motion.css) at the moment `gsap.set()` first runs, before
     `legacy-reveal.ts`'s IntersectionObserver has necessarily added `.in`.
     Measured effect at 1366×768: the incoming stage's rendered bottom edge
     sits ~31px below the plain flex-computed grid bottom (16.6px from the
     scale-1.03 growth being centered outward, 24px from the baked-in
     translate). 50px covers that with margin, at every stage, without
     touching pin.ts or legacy-reveal.ts (out of scope here). */
  .fleet-section.pin-ready {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 50px);
    padding-block: 0;
  }

  .fleet-section.pin-ready .wrap {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    /* top clearance must beat the fixed nav (72px max) with room to spare;
       bottom padding is purely cosmetic breathing room */
    padding-top: max(84px, 6vh);
    padding-bottom: clamp(20px, 4vh, 40px);
  }

  .fleet-section.pin-ready .section-head {
    flex: none;
    margin-bottom: clamp(16px, 3vh, 32px);
  }

  .fleet-section.pin-ready .fleet-grid {
    display: block;
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
  }

  .fleet-section.pin-ready .fleet-card {
    position: absolute;
    inset: 0;
    margin-inline: auto;
    width: min(100%, 560px);
    height: 100%;
  }

  /* the vehicle image is the elastic part — price/CTA below never shrink */
  .fleet-section.pin-ready .fleet-stage {
    aspect-ratio: auto;
    flex: 1 1 auto;
    min-height: 72px;
  }

  .fleet-section.pin-ready .fleet-body {
    flex: none;
  }

  /* hover lift เดิมชน transform ที่ scrub คุมอยู่ ตัดทิ้งเฉพาะโหมดนี้ */
  .fleet-section.pin-ready .fleet-card:hover {
    transform: none;
  }

  @media (max-width: 880px) {
    .fleet-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .fleet-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function () {
    'use strict';

    /* ---------- Fleet "choose this car" -> prefill + scroll ----------
       Live behaviour called selectVtype() directly (single-file script scope).
       Here that function lives inside ServiceTabs.astro's own scoped <script>
       module and is not exported, so this component reaches the booking form
       through the same shared DOM ids (.vtype-chip / #vehicleType) instead —
       the "shared DOM ids" integration point established in BookingForm.astro
       (Task 5). This reproduces selectVtype()'s exact DOM effect (chip active
       state + hidden input value) before scrolling to #booking. */
    document.querySelectorAll('.fleet-book').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var value = (btn as HTMLElement).dataset.vtype || 'any';
        var chips = document.querySelectorAll('.vtype-chip');
        var vtypeInput = document.getElementById('vehicleType') as HTMLInputElement | null;
        chips.forEach(function (c) {
          var on = (c as HTMLElement).dataset.value === value;
          c.classList.toggle('active', on);
          c.setAttribute('aria-checked', on ? 'true' : 'false');
        });
        if (vtypeInput) vtypeInput.value = value;

        var booking = document.getElementById('booking');
        if (booking) {
          var y = booking.getBoundingClientRect().top + window.scrollY - 88;
          window.scrollTo({ top: y, behavior: 'auto' });
        }
        var pickup = document.getElementById('b_pickup') as HTMLInputElement | null;
        if (pickup) pickup.focus();
      });
    });
  })();
</script>

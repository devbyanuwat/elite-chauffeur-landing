---
import { getLandingContent } from '../../lib/cms-api';
import { t } from '../../lib/cms-merge';

const cmsAll = await getLandingContent();
const TX = (cmsAll?.['stats'] as { texts?: Record<string, { th: string; en: string }> } | undefined)?.texts;
// ตัวเลข 3 ช่องแรกตั้งจาก BOS ได้ (ช่องทริปเป็นตัวเลขสดจากระบบ) — โครงผิดใช้ค่าเดิม
const rawValues = (cmsAll?.['stats'] as { values?: unknown } | undefined)?.values;
const statValues =
  Array.isArray(rawValues) && rawValues.length === 3 && rawValues.every((v) => typeof v === 'string' && v.trim())
    ? (rawValues as string[])
    : ['24/7', '4.9 / 5', '100%'];
import TripStat from './TripStat.astro';
---

<section class="stats chapter stats-chapter" id="stats" data-chapter="stats" data-chapter-len="160">
  <div class="wrap wrap-wide">
    <div class="stats-inner">
      <div class="stat"><b>{statValues[0]}</b><span data-i18n="stat.1">{t(TX, 'stat.1', 'บริการทุกวัน ไม่มีวันหยุด')}</span></div>
      <div class="stat"><b><TripStat server:defer><Fragment slot="fallback">500+</Fragment></TripStat></b><span data-i18n="stat.2">{t(TX, 'stat.2', 'เที่ยวเดินทางปลอดภัย')}</span></div>
      <div class="stat"><b>{statValues[1]}</b><span data-i18n="stat.3">{t(TX, 'stat.3', 'คะแนนจากลูกค้า')}</span></div>
      <div class="stat"><b>{statValues[2]}</b><span data-i18n="stat.4">{t(TX, 'stat.4', 'รถมี พ.ร.บ. ครบ')}</span></div>
    </div>
    <span class="stats-line" aria-hidden="true"></span>
  </div>
</section>

<style>
  .stats {
    border-block: 1px solid var(--border);
    background: var(--bg-secondary);
  }

  .stats-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    padding-block: clamp(2rem, 4vw, 2.8rem);
  }

  .stat {
    text-align: center;
    padding-inline: 0.5rem;
  }

  .stat b {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1;
    margin-bottom: 0.4rem;
  }

  .stat span {
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  @media (max-width: 880px) {
    .stats-inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.8rem 1rem;
    }
  }

  .stats-line {
    display: block;
    height: 1px;
    background: var(--gold-dark);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .stats-chapter.pin-ready {
    height: 100svh;
    display: grid;
    align-content: center;
  }

  .stats-chapter.pin-ready .stat {
    opacity: 0;
    transition: none;
  }

  .stats-chapter.pin-ready .stat.on {
    opacity: 1;
  }
</style>

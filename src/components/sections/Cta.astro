---
import { getLandingContent } from '../../lib/cms-api';
import { t } from '../../lib/cms-merge';

const cmsAll = await getLandingContent();
const contact = cmsAll?.['global-contact'] as { phone?: string } | undefined;
const telHref = 'tel:' + (contact?.phone ?? '0623879159').replace(/^\+66/, '0');
const TX = (cmsAll?.['cta'] as { texts?: Record<string, { th: string; en: string }> } | undefined)?.texts;
---

<section class="block" style="padding-top:0">
  <div class="wrap">
    <div class="cta-band" data-reveal-group="90">
      <h2 data-i18n="cta.title">{t(TX, 'cta.title', 'พร้อมออกเดินทางแล้วหรือยัง?')}</h2>
      <p data-i18n="cta.sub">{t(TX, 'cta.sub', 'จองรถได้ทันที หรือทักหาเราทาง LINE ทีมงานพร้อมดูแลคุณตลอด 24 ชั่วโมง')}</p>
      <div class="cta-actions">
        <a href="#booking" class="btn btn-primary btn-lg" data-i18n="cta.b1">{t(TX, 'cta.b1', 'จองรถ')}</a>
        <a href={telHref} class="btn btn-ghost btn-lg" data-i18n="cta.b2">{t(TX, 'cta.b2', 'โทร 062-387-9159')}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    background:
      radial-gradient(120% 140% at 100% 0%, oklch(64% 0.115 48 / 0.16) 0%, transparent 55%),
      var(--bg-dark);
    color: #fff;
    border-radius: var(--r-lg);
    padding: clamp(2.5rem, 5vw, 4rem);
    text-align: center;
    overflow: hidden;
  }

  .cta-band h2 {
    color: #fff;
    max-width: 620px;
    margin-inline: auto;
  }

  .cta-band p {
    color: oklch(82% 0.012 230);
    max-width: 520px;
    margin: 0.9rem auto 1.8rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
  }

  .cta-band .btn-ghost {
    color: #fff;
    border-color: oklch(100% 0 0 / 0.35);
  }

  .cta-band .btn-ghost:hover {
    border-color: #fff;
    background: oklch(100% 0 0 / 0.08);
  }
</style>

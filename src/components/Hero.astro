---
---

<section class="hero">
  <!-- data-depth-field: hero-depth.ts (src/scripts/motion/) mounts a three.js canvas here
       ONLY when the triple gate passes (>=1024px, motion allowed, WebGL2 present) — see
       docs/superpowers/plans/2026-07-27-landing-redesign-STATE.md item 8 for why strength
       is capped at 0.03. Below the gate, or if the textures fail to load, the <img> below
       is the only thing that ever renders here — it's never hidden by CSS or JS. -->
  <div
    class="hero-bg"
    data-depth-field
    data-depth-color="/images/hero-bg.travelv1-baseline.webp"
    data-depth-map="/images/parallax/hero-travelv1/depth.webp"
    data-depth-strength="0.03"
  >
    <img
      class="hero-bg-photo"
      src="/images/hero-bg.travelv1-baseline.webp"
      alt=""
      aria-hidden="true"
      width="1920"
      height="1080"
      fetchpriority="high"
    />
  </div>
  <div class="wrap wrap-wide hero-grid">
    <div class="hero-content">
      <h1>
        <span data-i18n="hero.t1">เดินทาง</span>
        <span class="underline" data-i18n="hero.t2">สบาย ๆ</span>
        <span data-i18n="hero.t3">กับคนขับ</span>
        <span class="accent" data-i18n="hero.t4">มืออาชีพ</span>
      </h1>
      <div class="hero-actions">
        <a href="#booking" class="btn btn-primary btn-lg" data-i18n="hero.cta1">จองรถ</a>
        <a href="https://line.me/R/ti/p/@031cvnva" target="_blank" rel="noopener nofollow" class="hero-line" data-i18n="hero.cta2">ปรึกษาผ่าน LINE</a>
      </div>
      <div class="hero-trust">
        <div class="hero-trust-item">
          <b>4.9<span class="stars">&#9733;</span></b>
          <span data-i18n="hero.trust1">จากลูกค้าจริง</span>
        </div>
      </div>
    </div>
  </div>
  <div class="hero-scroll" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero-bg-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Unconditional (not media-gated), matching the mockup: this is the crop used
       whenever the CSS fallback is what's on screen — below the WebGL gate, or above
       it while the depth-field textures are still loading / failed to load. Verified
       at 1440x900 and 390x844 (see the S3 hero-slice report) that her face, hat and
       hands stay clear of the veil at both sizes. */
    object-position: 30% 35%;
  }

  /* hero-depth.ts appends this canvas only once the real photo + depth map have
     loaded — sized/positioned here so it drops in without a layout jump the instant
     it mounts. Fully opaque (the fragment shader always writes alpha 1.0), so it
     simply paints over .hero-bg-photo; nothing needs to hide the <img> underneath. */
  .hero-bg :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* บังเฉพาะที่ข้อความอยู่ ไม่ทาทั้งเฟรม (spec ข้อ 8) — ครึ่งซ้ายที่เธอยืน
     และเจดีย์กลางภาพต้องใสสนิท ตัวเลขนี้เป็นค่าตั้งต้น ปรับได้ตามผลวัด
     contrast ใน Task 5 แต่ห้ามกลับไปทาทั้งเฟรม */
  .hero-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(102deg,
        transparent 0 42%,
        oklch(98% 0.008 75 / 0.55) 62%,
        oklch(98% 0.008 75 / 0.92) 100%);
  }

  .hero-grid {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .hero-content {
    width: min(100%, clamp(360px, 40vw, 520px));
  }

  .hero h1 {
    font-size: clamp(2.8rem, 5.2vw, 4.8rem);
    font-weight: 500;
    margin-bottom: 1.4rem;
  }

  /* Each span is one phrase; lines may only break between phrases. Without this,
     Thai dictionary line-breaking splits inside a phrase (seen at 1440px:
     "กับคนขับ" broke as กับคน/ขับ). Longest EN phrase "professional driver"
     still fits the narrowest supported viewport at the mobile h1 size. */
  .hero h1 span {
    white-space: nowrap;
  }

  .hero h1 .accent {
    font-style: italic;
    color: var(--gold-dark);
    position: relative;
  }

  .hero h1 .underline {
    position: relative;
    white-space: nowrap;
  }

  .hero h1 .underline::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.08em;
    height: 0.28em;
    background: var(--sun);
    opacity: 0.55;
    z-index: -1;
    border-radius: 4px;
  }

  /* ปุ่มหลักหนึ่งปุ่ม LINE เป็นลิงก์ข้อความ — สองปุ่มขนาดเท่ากันคือสองคำสั่ง
     ที่แข่งกันเอง ใน 3 วินาทีต้องมีคำสั่งเดียวที่ชัด */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.4rem;
  }

  .hero-line {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--gold-dark);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .hero-line:hover {
    text-decoration-thickness: 2px;
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    align-items: center;
  }

  .hero-trust-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero-trust-item b {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1;
  }

  .hero-trust-item span {
    font-size: 0.78rem;
    color: var(--text-tertiary);
  }

  .hero-trust .stars {
    color: var(--gold);
    letter-spacing: 2px;
    font-size: 0.9rem;
  }

  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    transform: translateX(-50%);
    color: var(--text-tertiary);
    animation: hero-bob 2.6s ease-in-out infinite;
  }

  .hero-scroll svg {
    width: 26px;
    height: 26px;
    display: block;
  }

  @keyframes hero-bob {

    0%,
    100% {
      transform: translate(-50%, 0);
    }

    50% {
      transform: translate(-50%, 6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-scroll {
      animation: none;
    }
  }

  /* มือถือและแท็บเล็ต: ภาพเป็นแถบของตัวเองใต้ nav ไม่มี veil เลย
     เบรกพอยต์ตรงกับ FULL_TIER_MIN_WIDTH (1024) ใน src/scripts/motion/tiers.ts
     เพื่อให้ "จอที่ไม่มี depth field" กับ "จอที่ภาพเป็นแถบ" เป็นชุดเดียวกัน */
  @media (max-width: 1023.98px) {
    .hero {
      min-height: 0;
      display: block;
      padding-top: 72px;
      padding-bottom: clamp(2rem, 8vw, 3rem);
    }

    .hero-bg {
      position: relative;
      inset: auto;
      width: 100%;
      height: 52vh;
      height: 52svh;
    }

    /* ไม่มี veil — ภาพต้องโชว์เต็ม ไม่มีอะไรทับ (spec ข้อ 5) */
    .hero-bg::after {
      display: none;
    }

    /* กล่องมีความสูงจริงแล้ว องค์ประกอบแนวตั้งของ object-position จึงกลับมาทำงาน
       ค่านี้เลือกให้หน้าเธออยู่ในเฟรมที่ 390px ต้องยืนยันด้วยภาพหน้าจอใน Task 5 */
    .hero-bg-photo {
      object-position: 32% 34%;
    }

    .hero-grid {
      justify-content: flex-start;
      padding-top: clamp(1.5rem, 6vw, 2.25rem);
    }

    .hero-content {
      width: 100%;
    }

    .hero h1 {
      font-size: clamp(2.1rem, 8vw, 2.8rem);
    }

    .hero-scroll {
      display: none;
    }
  }
</style>

---
import { getCollection, type CollectionEntry } from 'astro:content';
import { t } from '../../lib/cms-merge';
import { getLandingContent } from '../../lib/cms-api';
import { getContact } from '../../lib/contact';
import { routesSchema } from '../../lib/content-schemas';
import Base from '../../layouts/Base.astro';
import BookingForm from '../../components/BookingForm.astro';

/**
 * Shared template for both intercity route subpages (bangkok-to-hua-hin,
 * bangkok-to-pattaya). Task 7 — replaces the 2 duplicated static HTML files.
 * Everything that differs between the two live pages lives in
 * src/content/routes/*.yaml (see src/content.config.ts for the schema);
 * everything byte-identical between them (nav, footer, vehicle names/types,
 * i18n/reveal plumbing) lives once, right here.
 */

export async function getStaticPaths() {
  const entries = await getCollection('routes');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'routes'>;
}

const { entry } = Astro.props;
// Landing CMS override — เนื้อหาจาก BOS (key "route:<slug>") ต้องผ่าน zod เดียวกับ yaml
// ผิดโครงตกกลับ yaml เดิม + log — admin กรอกผิด build ไม่มีวันพัง
const cmsAll = await getLandingContent();
const contact = await getContact();
const CTX = (cmsAll?.['chrome-subpage'] as { texts?: Record<string, { th: string; en: string }> } | undefined)?.texts;
const cmsOverride = cmsAll?.[`route:${entry.id}`];
const parsed = cmsOverride ? routesSchema.safeParse(cmsOverride) : null;
if (cmsOverride && parsed && !parsed.success) {
  console.error(`[cms] route:${entry.id} override fails schema, using yaml`, parsed.error.issues[0]);
}
const d = parsed && parsed.success ? parsed.data : entry.data;

// ---- JSON-LD, built per-page from the collection entry (ported structure
// from the live <script type="application/ld+json"> blocks). ----
const serviceSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Intercity Transfer',
  name: d.serviceName,
  description: d.serviceDescription,
  provider: {
    '@type': 'LocalBusiness',
    name: 'SABUYGO',
    url: 'https://sabuygo.com',
    telephone: contact.phone,
  },
  areaServed: d.areaServed.map((name) => ({ '@type': 'City', name })),
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'THB',
    lowPrice: String(Math.min(...d.rateRows.flat())),
    highPrice: String(Math.max(...d.rateRows.flat())),
    offerCount: String(d.rateRows.flat().length),
  },
  url: d.canonical,
};

const breadcrumbSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: 'https://sabuygo.com/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'เส้นทางต่างจังหวัด',
      item: 'https://sabuygo.com/routes/',
    },
    { '@type': 'ListItem', position: 3, name: d.breadcrumbName, item: d.canonical },
  ],
};

const faqSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.faq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

// ---- Structure that never varies between the two route pages — hardcoded
// once here rather than duplicated in each YAML entry. ----
// VEHICLES ต้อง hardcode เสมอ ห้ามดึงจาก BOS /api/public/fleet — ฝั่งนั้นคืนกี่ชั้น
// เรียงยังไงก็ได้ จับคู่กับ rateRows ผิดแถวคือราคาผิด และเกินแถวคือ build พัง
// ชุดรถต้องตรงกับ rateRows ของเส้นทางนั้นแถวต่อแถว และเส้นทางไม่ได้มีชั้นเท่ากันทุกเส้น
//   5 ราคา (พัทยา)  = เก๋ง / MPV / SUV / รถตู้ / รถตู้ VIP
//   4 ราคา (หัวหิน) = เก๋ง / MPV / SUV / รถตู้ VIP   (ยังไม่มีชั้นรถตู้ธรรมดา)
// จับคู่ด้วย index เฉย ๆ ไม่ได้ เพราะแถวที่ 4 ของสองเส้นทางคนละคัน
const V_SEDAN = { name: 'รถเก๋งขนาดกลาง', key: 'veh.sedan' } as const;
const V_MPV = { name: 'รถ MPV', key: 'veh.mpv' } as const;
const V_SUV = { name: 'รถ SUV 7 ที่นั่ง', key: 'veh.suv' } as const;
const V_VAN = { name: 'รถตู้', key: 'veh.van' } as const;
const V_PREMIUM = { name: 'รถตู้ VIP', key: 'veh.vanvip' } as const;

// เริ่มต้น = sedan one-way = ช่องซ้ายบนของตาราง อ่านจากที่เดียวกับตาราง
const startPrice = `฿${d.rateRows[0][0].toLocaleString()}`;

const VEHICLES =
  d.rateRows.length === 5
    ? [V_SEDAN, V_MPV, V_SUV, V_VAN, V_PREMIUM]
    : [V_SEDAN, V_MPV, V_SUV, V_PREMIUM];

const ICONS: Record<string, string> = {
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  lines: '<path d="M3 12h18M3 6h18M3 18h18"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 010 20"/>',
  clock: '<path d="M12 2v10l4 2"/><circle cx="12" cy="12" r="10"/>',
  chat: '<path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/>',
  water: '<path d="M12 2l9 4v6c0 5-3.5 9.5-9 10-5.5-0.5-9-5-9-10V6l9-4z"/>',
  check: '<circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/>',
};

function fmt(n: number | null): string {
  return n === null ? '' : n.toLocaleString();
}
---

<Base
  title={d.title}
  description={d.description}
  canonical={d.canonical}
  ogTitle={d.ogTitle}
  ogDescription={d.ogDescription}
  twitterTitle={d.twitterTitle}
  twitterDescription={d.twitterDescription}
  keywords={d.keywords}
  jsonLd={[serviceSchema, breadcrumbSchema, faqSchema]}
  navBrandHref="/"
  navCtaHref="#bookingForm"
  pageI18n={d.bodyI18n}
>
  <main id="main">
    <section class="hero block">
      <div class="wrap hero-inner">
        <div class="hero-text">
          <div class="breadcrumb">
            <a href="/" data-i18n="crumb.home">{t(CTX, 'chrome.home', 'หน้าแรก')}</a>
            <span> / </span>
            <span data-i18n="crumb.current">{d.breadcrumbName}</span>
          </div>
          <h1 data-i18n="hero.h1" set:html={d.heroHeadingHtml} />
          <p class="sub" data-i18n="hero.sub">{d.heroSub}</p>
          <div class="route-stats">
            <div class="route-stat">
              <span class="num" data-i18n="stat.dist.num">{d.distanceKm}</span>
              <span class="lbl" data-i18n="stat.dist.lbl">กม.</span>
            </div>
            <div class="route-stat">
              <span class="num" data-i18n="stat.time.num">{d.travelTime}</span>
              <span class="lbl" data-i18n="stat.time.lbl">ชม. เดินทาง</span>
            </div>
            <div class="route-stat">
              {/* ไม่ต้อง toggle ภาษา: เป็นตัวเลขเงินที่เขียนเหมือนกันทั้งไทยและอังกฤษ
                  ค่ามาจาก rateRows แถวแรกคอลัมน์ one-way จึงตรงกับตารางเสมอ */}
              <span class="num">{startPrice}</span>
              <span class="lbl" data-i18n="stat.start.lbl">เริ่มต้น (sedan one-way)</span>
            </div>
          </div>
        </div>
        <div class="hero-form reveal">
          <BookingForm />
        </div>
      </div>
    </section>

    <section class="section section-alt block">
      <div class="wrap section-inner">
        <div class="section-head reveal">
          <span class="eyebrow">{t(CTX, 'chrome.serviceRates', 'Service Rates')}</span>
          <h2 data-i18n="price.h2">อัตราค่าบริการโดยประมาณ ตามประเภทการเดินทาง</h2>
          <p data-i18n="price.desc">{d.priceDesc}</p>
        </div>

        <table class="price-table reveal">
          <thead>
            <tr>
              <th data-i18n="price.col.vehicle">ประเภทรถ</th>
              {/* "One-way"/"Round-trip"/"Day-trip Xh" wrapped in their own
                  span (sibling to .desc, not its parent) so the i18n toggle
                  can replace each independently — a parent <th> with its own
                  data-i18n would otherwise blow away the nested .desc span's
                  DOM node on the very first toggle (innerHTML replaces all
                  descendants), silently deleting its own translation. */}
              <th><span data-i18n="price.col.oneway">One-way</span><span class="desc" data-i18n="price.col.oneway.d">ส่งครั้งเดียว</span></th>
              <th><span data-i18n="price.col.round">Round-trip</span><span class="desc" data-i18n="price.col.round.d">ไป-กลับ</span></th>
              <th><span data-i18n="price.col.day">พร้อมคนขับ เหมารายชม.</span><span class="desc" data-i18n="price.col.day.d">ติดต่อแจ้งรายละเอียด</span></th>
            </tr>
          </thead>
          <tbody>
            {
              VEHICLES.map((v, i) => (
                <tr>
                  <td data-label="ประเภทรถ">
                    <span class="veh-name" data-i18n={v.key}>{v.name}</span>
                  </td>
                  <td data-label="One-way">
                    <span class="price-currency">฿</span>
                    <span class="price">{d.rateRows[i][0].toLocaleString()}</span>
                  </td>
                  <td data-label="Round-trip">
                    <span class="price-currency">฿</span>
                    <span class="price">{d.rateRows[i][1].toLocaleString()}</span>
                  </td>
                  <td data-label="เหมารายชั่วโมง">
                    <span class="price-ask" data-i18n="price.ask">สอบถาม</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="price-note" data-i18n="price.footnote">{d.priceFootnote}</p>
      </div>
    </section>

    <section class="section block">
      <div class="wrap section-inner">
        <div class="section-head reveal">
          <h2 data-i18n="inc.h2">{t(CTX, 'chrome.included', 'ทุกการจองรวม')}</h2>
          <p data-i18n="inc.desc">{d.includedDesc}</p>
        </div>

        <div class="included-grid reveal">
          {
            d.included.map((item) => (
              <div class="included-item">
                <svg viewBox="0 0 24 24" set:html={ICONS[item.icon]} />
                <h4 data-i18n={`${item.i18nKey}.t`}>{item.title}</h4>
                <p data-i18n={`${item.i18nKey}.d`}>{item.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {
      d.extraRatesTable && (
        <section class="section block">
          <div class="wrap section-inner">
            <div class="section-head reveal">
              <h2>{d.extraRatesTable.heading}</h2>
              <p>{d.extraRatesTable.desc}</p>
            </div>

            <table class="price-table price-table--routes reveal">
              <colgroup>
                <col class="col-route" />
                <col class="col-price" />
                <col class="col-price" />
                <col class="col-price" />
              </colgroup>
              <thead>
                <tr>
                  <th data-i18n="extra.col.route">เส้นทาง</th>
                  <th><span data-i18n="extra.col.sedan">รถเก๋ง</span><span class="desc" data-i18n="extra.col.sedan.d">3 ที่นั่ง</span></th>
                  <th><span data-i18n="extra.col.suvmpv">SUV / MPV</span><span class="desc" data-i18n="extra.col.suvmpv.d">6-7 ที่นั่ง</span></th>
                  <th><span data-i18n="extra.col.van">รถตู้ VIP</span><span class="desc" data-i18n="extra.col.van.d">6 ที่นั่ง</span></th>
                </tr>
              </thead>
              <tbody>
                {
                  d.extraRatesTable.rows.map((row) => (
                    <tr>
                      <td data-label="เส้นทาง">
                        <span class="veh-name">{row.route}</span>
                        {row.note && <span class="veh-type">{row.note}</span>}
                      </td>
                      <td data-label="Sedan">
                        {row.sedan === null ? (
                          <span class="price-unavailable">{t(CTX, 'chrome.ask', 'สอบถาม')}</span>
                        ) : (
                          <>
                            <span class="price-currency">฿</span>
                            <span class="price">{fmt(row.sedan)}</span>
                          </>
                        )}
                      </td>
                      <td data-label="SUV / MPV">
                        {row.suv === null ? (
                          <span class="price-unavailable">{t(CTX, 'chrome.ask', 'สอบถาม')}</span>
                        ) : (
                          <>
                            <span class="price-currency">฿</span>
                            <span class="price">{fmt(row.suv)}</span>
                          </>
                        )}
                      </td>
                      <td data-label="VAN">
                        {row.van === null ? (
                          <span class="price-unavailable">{t(CTX, 'chrome.ask', 'สอบถาม')}</span>
                        ) : (
                          <>
                            <span class="price-currency">฿</span>
                            <span class="price">{fmt(row.van)}</span>
                          </>
                        )}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <p class="price-note">{d.extraRatesTable.footnote}</p>
          </div>
        </section>
      )
    }

    <section class="related-strip">
      <div class="wrap related-inner">
        <div>
          <h3 data-i18n="rel.label">{d.related.heading}</h3>
          <p data-i18n="rel.desc">{d.related.desc}</p>
        </div>
        <a href={d.related.href} data-i18n="rel.cta">{d.related.cta}</a>
      </div>
    </section>

    <section class="section block">
      <div class="wrap section-inner faq-inner">
        <div class="section-head center reveal">
          <h2 data-i18n="faq.h2">{t(CTX, 'chrome.faqTitle', 'คำถามที่พบบ่อย')}</h2>
          <p data-i18n="faq.desc">สงสัยเรื่องเส้นทาง ราคา หรือ trip type? ดูคำตอบด้านล่าง</p>
        </div>

        <div class="faq-list reveal">
          {
            d.faq.map((f, i) => (
              <details class="faq-item">
                <summary data-i18n={`faq.q${i + 1}`}>{f.question}</summary>
                <div class="faq-answer" data-i18n={`faq.a${i + 1}`}>{f.answer}</div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="cta-footer">
      {/* h2 intentionally NOT toggled: this heading is shared literal markup
          across both route pages ("พร้อมออกเดินทาง?"), which already differs
          from either live page's page-specific TH text ("พร้อมไปหัวหิน?" /
          "พร้อมไปพัทยา?") — a pre-existing simplification out of B1/B2 scope.
          Pulling live's page-specific EN string here would pair a generic
          Thai default with a page-specific English swap, a mismatch we're
          not going to invent. */}
      <h2 set:html={t(CTX, 'chrome.ctaRoutes', 'พร้อมออกเดินทาง?<br />เลือก trip type ที่ใช่')} />
      <p data-i18n="cta.desc">กรอกฟอร์มด้านบนหรือ LINE หาเรา — ทีมงานตอบกลับใน 15 นาที</p>
      <div class="actions">
        <a href="#bookingForm" class="btn btn-primary btn-lg" data-i18n="cta.book">กรอกฟอร์มจอง</a>
        <a href={contact.lineUrl} class="btn btn-line btn-lg" target="_blank" rel="noopener nofollow">LINE {contact.lineId}</a>
      </div>
    </section>
  </main>
</Base>

<style>
  /* ==================== HERO ==================== */
  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
  }

  .breadcrumb {
    font-size: 0.74rem;
    letter-spacing: var(--tracking-wide);
    color: var(--text-tertiary);
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }
  .breadcrumb a {
    color: var(--text-secondary);
  }
  .breadcrumb a:hover {
    color: var(--gold-dark);
  }

  .hero-text h1 {
    font-size: clamp(1.85rem, 4.2vw, 3.1rem);
    margin-bottom: 1.25rem;
  }

  .hero-text .sub {
    font-size: clamp(1rem, 1.35vw, 1.1rem);
    color: var(--text-secondary);
    margin-bottom: 2rem;
    max-width: 540px;
  }

  .route-stats {
    display: flex;
    gap: 2rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .route-stat {
    font-size: 0.82rem;
  }
  .route-stat .num {
    display: block;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.15rem;
  }
  .route-stat .lbl {
    color: var(--text-tertiary);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-size: 0.68rem;
  }

  .hero-form {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  /* ==================== PRICE TABLES ==================== */
  /* จังหวะแนวตั้ง: ทุก section ใช้ --section-spacing เท่ากันอยู่แล้ว แต่ margin ของ
     เนื้อหาชิ้นสุดท้ายทำให้ระยะที่ตาเห็นเหวี่ยง 27-241px — ตัดทิ้งให้ระยะมาจาก token เดียว */
  .section-inner > :last-child,
  .section-head > :last-child {
    margin-block-end: 0;
  }

  /* section.block ใส่ padding-block: var(--section-spacing) ทั้งบนและล่าง (141px ที่จอ 1280)
     section บนหน้านี้พื้นหลังโปร่งเหมือนกันหมด ยกเว้น .related-strip กับ .cta-footer
     ที่มีสีของตัวเอง — สอง section พื้นเดียวกันชนกันจึงได้ระยะซ้อน 282px ที่อ่านเป็นช่องโหว่
     รอยต่อควรเป็นหนึ่งหน่วยเดียว: ปล่อยให้ระยะมาจาก padding-bottom ของ section ก่อนหน้า
     (บล็อกที่มีพื้นหลังเองยังต้องมี padding-top ของตัวเอง จึงไม่โดนกฎนี้) */
  .block + .block {
    padding-top: 0;
  }

  .price-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    overflow: hidden;
    font-size: 0.9rem;
  }
  .price-table thead th {
    background: var(--bg-secondary);
    padding: 0.95rem 1rem;
    text-align: left;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-tertiary);
    border-bottom: 1px solid var(--border);
  }
  .price-table thead th .desc {
    display: block;
    font-size: 0.68rem;
    font-weight: 400;
    color: var(--text-tertiary);
    letter-spacing: 0;
    text-transform: none;
    margin-top: 0.2rem;
  }
  .price-table tbody td {
    padding: 1rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .price-table tbody tr:last-child td {
    border-bottom: none;
  }
  .price-table .veh-name {
    font-weight: 600;
    color: var(--text-primary);
    display: block;
  }
  .price-table .veh-type {
    display: block;
    font-size: 0.78rem;
    color: var(--text-tertiary);
    margin-top: 0.15rem;
    font-weight: 400;
  }
  .price-table .price {
    font-weight: 600;
    color: var(--text-primary);
  }
  .price-table .price-currency {
    font-size: 0.78rem;
    color: var(--text-tertiary);
    font-weight: 400;
  }
  /* หมายเหตุเป็นบรรทัดท้ายของตาราง ไม่ใช่ข้อความลอยเหนือช่องว่างท้าย section
     (หลังตัดข้อความเหลือบรรทัดเดียว มันลอยอยู่เหนือระยะ 144px โดยไม่มีอะไรถ่วง) */

---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Booking from '../components/sections/Booking.astro';
import Stats from '../components/sections/Stats.astro';
import Product from '../components/sections/Product.astro';
import Fleet from '../components/sections/Fleet.astro';
import How from '../components/sections/How.astro';
import Why from '../components/sections/Why.astro';
import Reviews from '../components/sections/Reviews.astro';
import StaticReviews from '../components/sections/StaticReviews.astro';
import Faq from '../components/sections/Faq.astro';
import Cta from '../components/sections/Cta.astro';
import BlogTeaser from '../components/sections/BlogTeaser.astro';
import StickyCta from '../components/StickyCta.astro';
import ChapterRail from '../components/ChapterRail.astro';
import {
  limousineServiceSchema,
  websiteSchema,
  siteNavigationSchema,
  breadcrumbSchema,
} from '../lib/schema.ts';
import { getReviewSummary } from '../lib/reviews-api';
import { getLandingContent } from '../lib/cms-api';
import { collectEnOverrides, isHidden, t } from '../lib/cms-merge';
import { buildProductCatalogSchema } from '../lib/product-cms';

// ruling (2026-08-23, deferred by design): this runs at BUILD time, but
// <Reviews server:defer> below renders the visible review cards at REQUEST
// time — the two can disagree, so the JSON-LD rating can lag the visible
// cards until the next rebuild. Accepted trade, not a bug to fix here:
// before this branch the JSON-LD rating was a hardcoded fake 4.9/128 that
// matched nothing at all, so real build-time data is strictly better even
// with the lag, and Reviews was already a server island before this branch
// (unrelated to fleet/reviews-from-BOS work). Unifying the two phases is a
// separate, larger change — not part of this fix wave.
const reviewSummary = await getReviewSummary();

// Landing CMS — เนื้อหาทุก section แก้จาก BOS (/v3/landing) เห็นผลตอน rebuild
const cmsAll = await getLandingContent();
const hidden = (key: string) => isHidden(cmsAll, key);
const pageI18n = collectEnOverrides(cmsAll);
const TM = (cmsAll?.['static-reviews'] as { texts?: Record<string, { th: string; en: string }> } | undefined)?.texts;
const contact = cmsAll?.['global-contact'] as
  | { phone?: string; lineUrl?: string }
  | undefined;
// เบอร์/LINE จาก CMS ไหลเข้า JSON-LD ด้วย — clone แล้วทับเฉพาะ field ที่เกี่ยว
const limousineSchemaLive: Record<string, unknown> = {
  ...limousineServiceSchema,
  ...(contact?.phone ? { telephone: contact.phone } : {}),
  ...(contact?.lineUrl ? { sameAs: [contact.lineUrl] } : {}),
};
const productCatalogSchema = buildProductCatalogSchema(cmsAll);

const title = 'SABUYGO | Premium Car Rental & Chauffeur Service Bangkok';
const description =
  'บริการรถเช่าพร้อมคนขับระดับพรีเมียม กรุงเทพฯ รับส่งสนามบิน ธุรกิจ ท่องเที่ยว มีประกันทุกคัน คนขับผ่านการคัดสรร ปลอดภัย 24 ชม. Premium chauffeur service in Bangkok.';
const canonical = 'https://sabuygo.com';
// og:title/og:description are shorter than the <title>/description above on
// live — not a default fallback, so pass them explicitly (Task 7 fix).
// twitter:title/twitter:description mirror these on live, so they're left to
// Base.astro's default (twitterTitle = ogTitle, twitterDescription = ogDescription).
const ogTitle = 'SABUYGO | Premium Chauffeur Service Bangkok';
const ogDescription =
  'บริการรถเช่าพร้อมคนขับระดับพรีเมียม กรุงเทพฯ มีประกันทุกคัน คนขับผ่านการคัดสรร ปลอดภัย 24 ชม.';

// Page-level WebPage node — carries speakable for Product's answer paragraphs
// (per Product.astro's mounting note: speakable belongs at page level; no other
// schema on this page declares @type WebPage, verified — no collision).
// Lives here, not schema.ts: schema.ts exports are all ported from the legacy
// index.html and this node has no legacy counterpart.
const webPageSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://sabuygo.com/#webpage',
  url: 'https://sabuygo.com',
  name: title,
  speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.pd-answer'] },
};
---
<Base
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  pageI18n={pageI18n}
  jsonLd={[limousineSchemaLive, websiteSchema, siteNavigationSchema, breadcrumbSchema, productCatalogSchema, webPageSchema]}
>
  <main id="main">
    <Hero />
    {!hidden('stats') && <Stats />}
    {!hidden('product') && <Product />}
    {!hidden('fleet') && <Fleet />}
    {!hidden('how') && <How />}
    {!hidden('why') && <Why />}
    {!hidden('static-reviews') && (
    <section class="block tm-section" id="reviews">
      <div class="wrap">
        <div class="section-head center reveal">
          <span class="eyebrow" data-i18n="tm.eyebrow">{t(TM, 'tm.eyebrow', 'รีวิวจริงจากลูกค้า')}</span>
          <h2 data-i18n="tm.title">{t(TM, 'tm.title', 'ลูกค้าพูดถึงเราอย่างไร')}</h2>
          <p data-i18n="tm.sub">{t(TM, 'tm.sub', 'เสียงส่วนหนึ่งจากผู้ที่เดินทางไปกับเรา')}</p>
        </div>
      </div>
      <Reviews server:defer>
        <StaticReviews slot="fallback" />
      </Reviews>
      </section>
    )}
    {!hidden('faq') && <Faq />}
    {!hidden('booking') && <Booking />}
    <BlogTeaser />
    {!hidden('cta') && <Cta />}
    <StickyCta />
  </main>
  <ChapterRail />
</Base>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'SABUYGO',
  url: 'https://sabuygo.com',
  ...(reviewSummary
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: String(reviewSummary.average),
          reviewCount: String(reviewSummary.count),
          bestRating: '5',
        },
      }
    : {}),
})} />

<script>
  (function () {
    'use strict';
    // Mobile tap toggles reveal (desktop uses :hover / :focus-within CSS).
    // CTA click pre-fills the booking form's vehicle type via the existing
    // ServiceTabs controls, then scrolls to the form and focuses the pickup field.
    // (service type is optional: only applied if a card carries data-svc.)
    document.addEventListener('click', function (e) {
      var target = e.target as HTMLElement;
      var cta = target.closest('.tm-cta') as HTMLElement | null;
      if (cta) {
        var svc = cta.dataset.svc;
        var veh = cta.dataset.vehicle;
        if (svc) { var t = document.querySelector('.svc-tab[data-svc="' + svc + '"]') as HTMLButtonElement | null; if (t) t.click(); }
        if (veh) { var c = document.querySelector('.vtype-chip[data-value="' + veh + '"]') as HTMLButtonElement | null; if (c) c.click(); }
        var form = document.getElementById('bookingForm');
        if (form) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        var pickup = document.getElementById('b_pickup') as HTMLInputElement | null;
        if (pickup) { var pk = pickup; window.setTimeout(function () { pk.focus(); }, 400); }
        return;
      }
      // Tap-to-reveal on touch: toggle .is-open on the tapped card (ignore desktop hover devices).
      if (window.matchMedia('(hover: none)').matches) {
        var card = target.closest('.tm-card') as HTMLElement | null;
        if (card) {
          document.querySelectorAll('.tm-card.is-open').forEach(function (o) { if (o !== card) o.classList.remove('is-open'); });
          card.classList.toggle('is-open');
        }
      }
    });
  })();
</script>
